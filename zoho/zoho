#!/usr/bin/env python3
"""Zoho CRM API v8 CLI (OAuth 2.0 self client)."""

import difflib
import json
import mimetypes
import os
import re
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

CONFIG_DIR = os.path.expanduser("~/.config/zoho")
ENV_PATH = os.path.join(CONFIG_DIR, "env")
TOKENS_PATH = os.path.join(CONFIG_DIR, "tokens.json")

# 同一 API を秒間に叩きすぎると CONCURRENCY / rate limit で落ちるため間隔を空ける
MIN_INTERVAL = 0.2
_last_call = 0.0


# 取り切れずに返したときの理由。取れた分は出したうえで exit 1 にする
_incomplete = None


def incomplete(msg):
    global _incomplete
    _incomplete = msg
    print(f"# {msg}", file=sys.stderr)


def secure(path, mode):
    """権限を必ず mode まで絞る。makedirs(mode=) は既存ディレクトリには効かず、
    作成時の mode も umask で削られるので、実行のたびに現在値を見て直す。"""
    current = stat.S_IMODE(os.stat(path).st_mode)
    if current != mode:
        os.chmod(path, mode)
        print(f"# {path} の権限を {current:04o} から {mode:04o} に直しました", file=sys.stderr)


def die(msg):
    print(f"zoho: {msg}", file=sys.stderr)
    sys.exit(1)


def load_env():
    if not os.path.exists(ENV_PATH):
        die(f"{ENV_PATH} がありません。`zoho init` を実行してください")
    # ファイルだけ閉じても、ディレクトリが書ける状態なら env ごと差し替えられる
    secure(CONFIG_DIR, 0o700)
    secure(ENV_PATH, 0o600)
    env = {}
    with open(ENV_PATH) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip().strip('"').strip("'")
    for key in ("ZOHO_CLIENT_ID", "ZOHO_CLIENT_SECRET"):
        if not env.get(key):
            die(f"{ENV_PATH} に {key} がありません")
    env.setdefault("ZOHO_DC", "jp")
    dc = env["ZOHO_DC"]
    # client_secret を送る先のホスト名になるので、既知のデータセンターだけ許す
    if dc not in ("jp", "com", "eu", "in", "com.au", "com.cn", "ca"):
        die(f"ZOHO_DC が不正です: {dc}")
    env.setdefault("ZOHO_ACCOUNTS_BASE", f"https://accounts.zoho.{dc}")
    env.setdefault("ZOHO_API_BASE", f"https://www.zohoapis.{dc}")
    env.setdefault("ZOHO_API_VERSION", "v8")
    for k in ("ZOHO_ACCOUNTS_BASE", "ZOHO_API_BASE"):
        env[k] = env[k].rstrip("/")
    return env


def save_tokens(tokens):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    secure(CONFIG_DIR, 0o700)
    tmp = TOKENS_PATH + ".tmp"
    # open() してから chmod すると、その間は umask の権限で refresh_token が読める
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(tokens, f, indent=2)
        os.replace(tmp, TOKENS_PATH)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def load_tokens():
    if not os.path.exists(TOKENS_PATH):
        die("未認証です。`zoho auth <grant_token>` を実行してください")
    with open(TOKENS_PATH) as f:
        return json.load(f)


def post_form(url, params):
    body = urllib.parse.urlencode(params).encode()
    req = urllib.request.Request(url, data=body, method="POST")
    req.add_header("Content-Type", "application/x-www-form-urlencoded")
    try:
        with urllib.request.build_opener(_NoRedirect).open(req, timeout=60) as res:
            raw = res.read().decode(errors="replace")
            try:
                return json.loads(raw) if raw.strip() else {}
            except ValueError:
                die(f"{url} -> JSON が返りませんでした: {raw[:300]}")
    except urllib.error.HTTPError as e:
        die(f"{url} -> {e.code} {e.read().decode(errors='replace')[:500]}")
    except urllib.error.URLError as e:
        die(f"Zoho に接続できません: {e.reason}")


def token_endpoint(env):
    return f"{env['ZOHO_ACCOUNTS_BASE']}/oauth/v2/token"


def cmd_auth(env, args):
    if not args:
        die("usage: zoho auth <grant_token>")
    res = post_form(token_endpoint(env), {
        "grant_type": "authorization_code",
        "client_id": env["ZOHO_CLIENT_ID"],
        "client_secret": env["ZOHO_CLIENT_SECRET"],
        "code": args[0],
    })
    if "refresh_token" not in res:
        # res をそのまま出すと access_token が端末とスクロールバックに残る。
        # offline アクセス無しの grant token だと access_token だけが返る
        detail = res.get("error") or f"返ったキー: {', '.join(res)}"
        die(f"refresh_token が返りませんでした（{detail}）。"
            "grant token を offline アクセスで作り直してください")
    save_tokens({
        "access_token": res["access_token"],
        "refresh_token": res["refresh_token"],
        "expires_at": time.time() + int(res.get("expires_in", 3600)),
        "api_domain": res.get("api_domain", env["ZOHO_API_BASE"]),
    })
    print(f"ok: {TOKENS_PATH} に保存しました (api_domain={res.get('api_domain')})")


def cmd_revoke(env, args):
    opts = [a for a in args if a in ("-y", "--yes")]
    args = [a for a in args if a not in ("-y", "--yes")]
    if len(args) != 1:
        die("usage: zoho revoke <refresh_token | -> [-y]")
    # 引数に直接書くとシェル履歴と ps に残るので、標準入力からも受ける
    token = sys.stdin.readline().strip() if args[0] == "-" else args[0]
    if not token:
        die("トークンが空です")
    stored = json.load(open(TOKENS_PATH)).get("refresh_token") if os.path.exists(TOKENS_PATH) else None
    # tokens.json と同じ値が Secret Manager（zoho-connector）にも入っていて、毎朝のジョブが読む
    if token == stored and not opts:
        die("これは今 tokens.json で使っている refresh_token です。失効させるとコネクタも"
            "止まります。分かったうえで消すなら -y を付けてください")
    # 失敗時のエラーに URL を出すと token が端末に残るので、post_form は使わない
    url = f"{env['ZOHO_ACCOUNTS_BASE']}/oauth/v2/token/revoke?" + urllib.parse.urlencode({"token": token})
    req = urllib.request.Request(url, data=b"", method="POST")
    try:
        with urllib.request.build_opener(_NoRedirect).open(req, timeout=60) as res:
            raw = res.read().decode(errors="replace")
    except urllib.error.HTTPError as e:
        die(f"revoke -> {e.code} {e.read().decode(errors='replace')[:300]}")
    except urllib.error.URLError as e:
        die(f"Zoho に接続できません: {e.reason}")
    try:
        res = json.loads(raw)
    except ValueError:
        die(f"revoke -> JSON が返りませんでした: {raw[:300]}")
    if res.get("status") != "success":
        die(f"revoke できませんでした: {json.dumps(res, ensure_ascii=False)}")
    print("ok: 失効させました" + ("（tokens.json の分です。`zoho auth` が必要）" if token == stored else ""))


def access_token(env, force=False):
    t = load_tokens()
    if not force and t.get("access_token") and t.get("expires_at", 0) > time.time() + 60:
        return t
    res = post_form(token_endpoint(env), {
        "grant_type": "refresh_token",
        "client_id": env["ZOHO_CLIENT_ID"],
        "client_secret": env["ZOHO_CLIENT_SECRET"],
        "refresh_token": t["refresh_token"],
    })
    if "access_token" not in res:
        die(f"リフレッシュ失敗: {json.dumps(res, ensure_ascii=False)}. `zoho auth` をやり直してください")
    t["access_token"] = res["access_token"]
    t["expires_at"] = time.time() + int(res.get("expires_in", 3600))
    if res.get("api_domain"):
        t["api_domain"] = res["api_domain"]
    save_tokens(t)
    return t


def origin(url):
    p = urllib.parse.urlsplit(url)
    return (p.scheme, p.netloc)


def allowed_origins(env, tokens):
    """トークンを付けて叩いてよいホスト。api_domain は認可時に Zoho が返した値。"""
    origins = {origin(u) for u in (tokens.get("api_domain"), env["ZOHO_API_BASE"]) if u}
    # Bulk Write のアップロードなどファイル系の API は content.zohoapis.* に出る
    content = {(scheme, "content." + host[len("www."):])
               for scheme, host in origins if host.startswith("www.zohoapis.")}
    return origins | content


RESERVED_HEADERS = ("authorization", "host", "content-length")


def take_flag(args, *names):
    """names のどれかを取り除き、あったかどうかを返す。"""
    rest = [a for a in args if a not in names]
    return len(rest) != len(args), rest


def take_values(args, *names):
    """`-o x` のように値を取るオプションを (値の一覧, 残りの引数) に分ける。"""
    values, rest, i = [], [], 0
    while i < len(args):
        if args[i] in names:
            if i + 1 >= len(args):
                die(f"{args[i]} には値が要ります")
            values.append(args[i + 1])
            i += 2
        else:
            rest.append(args[i])
            i += 1
    return values, rest


def take_headers(args):
    """`-H 'Name: value'`（繰り返し可）を dict にする。トークンの付け替えにならないよう
    Authorization などは受けない。"""
    raw, rest = take_values(args, "-H", "--header")
    headers = {}
    for h in raw:
        name, sep, value = h.partition(":")
        name = name.strip()
        if not sep or not name:
            die(f"不正なヘッダ: {h}（'Name: value' 形式）")
        if name.lower() in RESERVED_HEADERS:
            die(f"{name} は指定できません")
        headers[name] = value.strip()
    return headers, rest


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """リダイレクトを追わない。urllib は転送先が別ホストでも Authorization を持ち回るため、
    許可したオリジンを一度確認しても、その先で外部に渡ってしまう。"""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def api_url(env, tokens, path):
    """アクセストークンを付けて叩く URL。設定した Zoho のオリジン以外は組み立てない。"""
    if "://" in path:
        if origin(path) not in allowed_origins(env, tokens):
            die(f"Zoho 以外のホストには送れません: {path}")
        return path
    base = tokens.get("api_domain") or env["ZOHO_API_BASE"]
    path = path.lstrip("/")
    if not path.startswith("crm/"):
        path = f"crm/{env['ZOHO_API_VERSION']}/{path}"
    return f"{base}/{path}"


def send(env, method, path, params=None, data=None, content_type=None, headers=None,
         _retried=False):
    """アクセストークンを付けて送り、(url, 応答ヘッダ, 本文のバイト列) を返す。"""
    global _last_call
    tokens = access_token(env)
    url = api_url(env, tokens, path)
    if params:
        url += ("&" if "?" in url else "?") + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, data=data, method=method)
    for k, v in (headers or {}).items():
        req.add_header(k, v)
    req.add_header("Authorization", f"Zoho-oauthtoken {tokens['access_token']}")
    if content_type:
        req.add_header("Content-Type", content_type)
    wait = MIN_INTERVAL - (time.time() - _last_call)
    if wait > 0:
        time.sleep(wait)
    _last_call = time.time()
    opener = urllib.request.build_opener(_NoRedirect)
    try:
        with opener.open(req, timeout=120) as res:
            return url, res.headers, res.read()
    except urllib.error.HTTPError as e:
        # HTTPError は URLError の派生。この順序を入れ替えると 3xx と 401 の処理が死ぬ
        raw = e.read().decode(errors="replace")
        if e.code == 304:
            # If-Modified-Since に対する「更新なし」。エラーではないが、空の応答と
            # 取り違えないよう stderr に残す
            print("# 304 Not Modified（更新なし）", file=sys.stderr)
            return url, e.headers, b""
        if 300 <= e.code < 400:
            die(f"{method} {url} -> {e.code} リダイレクトは追いません"
                f"（転送先: {e.headers.get('Location')}）")
        if e.code == 401 and not _retried:
            access_token(env, force=True)
            return send(env, method, path, params, data, content_type, headers,
                        _retried=True)
        die(f"{method} {url} -> {e.code} {raw[:1000]}")
    except urllib.error.URLError as e:
        die(f"Zoho に接続できません: {e.reason}")


def decode_json(method, url, headers, raw):
    raw = raw.decode(errors="replace")
    if not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except ValueError:
        if headers.get_filename():
            die(f"{method} {url} -> ファイル（{headers.get_filename()}）が返りました。"
                "関数のコードなら `zoho fn pull` で取ってください")
        die(f"{method} {url} -> JSON が返りませんでした: {raw[:300]}")


def call(env, method, path, params=None, body=None, headers=None):
    data = json.dumps(body).encode() if body is not None else None
    url, resp_headers, raw = send(env, method, path, params, data,
                                  "application/json" if data else None, headers)
    return decode_json(method, url, resp_headers, raw)


def data_key(res):
    """--all で辿る配列のキー。

    候補が複数のとき JSON の並び順で選ぶと、関係ない配列を伸ばして本命を 1 ページ目の
    まま返す。決め打ちできるときだけ返し、駄目なら呼び出し側で打ち切りに倒す。
    """
    if not isinstance(res, dict):
        return None
    if isinstance(res.get("data"), list):
        return "data"
    cands = [k for k, v in res.items() if k != "info" and isinstance(v, list)]
    return cands[0] if len(cands) == 1 else None


GET_USAGE = "usage: zoho get <path> [key=value ...] [--all] [-H 'Name: value'] [-o <file | -> [-y]]"


def save_download(dest, raw, overwrite):
    if dest == "-":
        sys.stdout.buffer.write(raw)
        return
    # 顧客データを含みうるので、他のユーザーには読ませない
    flags = os.O_CREAT | os.O_WRONLY | (os.O_TRUNC if overwrite else os.O_EXCL)
    try:
        fd = os.open(os.path.expanduser(dest), flags, 0o600)
    except FileExistsError:
        die(f"{dest} が既にあります。上書きするなら -y を付けてください")
    except OSError as e:
        die(f"{dest} に書けません: {e.strerror}")
    with os.fdopen(fd, "wb") as f:
        f.write(raw)


def cmd_get(env, args):
    fetch_all, args = take_flag(args, "--all")
    overwrite, args = take_flag(args, "-y", "--yes")
    headers, args = take_headers(args)
    outs, args = take_values(args, "-o", "--output")
    if not args:
        die(GET_USAGE)
    path, params = args[0], {}
    for a in args[1:]:
        if "=" not in a:
            die(f"不正な引数: {a} (key=value 形式)")
        k, v = a.split("=", 1)
        params[k] = v
    if outs:
        if fetch_all:
            die("-o と --all は一緒に使えません")
        url, resp_headers, raw = send(env, "GET", path, params, headers=headers)
        if not raw:
            die(f"GET {url} -> 本文が空です（ファイルが無いか、更新なし）")
        save_download(outs[-1], raw, overwrite)
        name = resp_headers.get_filename()
        print(f"ok: {len(raw)} バイトを {outs[-1]} に保存しました"
              + (f"（元のファイル名: {name}）" if name else ""), file=sys.stderr)
        return
    res = call(env, "GET", path, params, headers=headers)
    if not fetch_all:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return
    key = data_key(res)
    if key is None:
        cands = [k for k, v in res.items() if k != "info" and isinstance(v, list)] \
            if isinstance(res, dict) else []
        if (res.get("info") or {}).get("more_records") if isinstance(res, dict) else False:
            incomplete(f"辿る配列を決められないので 1 ページ目だけ返します"
                       f"（{'/'.join(cands) or '配列なし'}）")
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return
    rows = list(res[key])
    info = res.get("info") or {}
    seen = set()
    while info.get("more_records"):
        token = info.get("next_page_token")
        if token:
            if token in seen:
                incomplete(f"next_page_token が繰り返されたので {len(rows)} 件で打ち切りました")
                break
            seen.add(token)
            params["page_token"] = token
        else:
            # 使い終わった page_token を残したまま page を足すと、Zoho はトークンを
            # 優先して page を無視するので、同じページを永久に取り直す
            params.pop("page_token", None)
            params["page"] = int(params.get("page", 1)) + 1
        res = call(env, "GET", path, params, headers=headers)
        chunk = res.get(key)
        if not isinstance(chunk, list):
            incomplete(f"2 ページ目以降に {key} がありません。{len(rows)} 件で打ち切りました")
            break
        rows.extend(chunk)
        info = res.get("info") or {}
        print(f"  ... {len(rows)} 件", file=sys.stderr)
    # 元の応答の他のフィールドを落とさない（key 以外を黙って捨てていた）
    out = {k: v for k, v in res.items() if k not in (key, "info")}
    out[key] = rows
    out["info"] = {"count": len(rows)}
    print(json.dumps(out, ensure_ascii=False, indent=2))


def read_body(args):
    """残り引数から JSON body を取る。@file / - (stdin) / インライン JSON。"""
    if not args:
        return json.load(sys.stdin)
    src = args[0]
    if src == "-":
        return json.load(sys.stdin)
    if src.startswith("@"):
        with open(os.path.expanduser(src[1:])) as f:
            return json.load(f)
    return json.loads(src)


def cmd_write(env, method, args):
    opts = [a for a in args if a in ("-y", "--yes")]
    args = [a for a in args if a not in ("-y", "--yes")]
    headers, args = take_headers(args)
    if not args:
        die(f"usage: zoho {method.lower()} <path> [@file | - | '<json>'] [-H 'Name: value'] [-y]")
    if method == "DELETE" and not opts:
        if not sys.stdin.isatty():
            die("DELETE は確認が要ります。非対話で実行するなら -y を付けてください")
        base = env["ZOHO_API_BASE"]
        print(f"{method} {base}/crm/{env['ZOHO_API_VERSION']}/{args[0].lstrip('/')}",
              file=sys.stderr)
        if input("本番の CRM を変更します。よろしいですか? [y/N] ").strip().lower() \
                not in ("y", "yes"):
            die("中止しました")
    res = call(env, method, args[0], headers=headers,
               body=read_body(args[1:]) if method != "DELETE" or args[1:] else None)
    print(json.dumps(res, ensure_ascii=False, indent=2))
    check_write_result(res)


def check_write_result(res):
    """一括 API は HTTP 200 の中にレコード単位の失敗を返す。ここを見ないと
    全件拒否でも exit 0 になり、`zoho patch … && 次の処理` がそのまま進む。"""
    rows = res.get("data") if isinstance(res, dict) else None
    if not isinstance(rows, list):
        return
    bad = [r for r in rows
           if isinstance(r, dict) and str(r.get("status", "")).lower() == "error"]
    if bad:
        codes = sorted({str(r.get("code")) for r in bad})
        die(f"{len(rows)} 件中 {len(bad)} 件が失敗しました（{', '.join(codes)}）")


UPLOAD_USAGE = "usage: zoho upload <path> <file> [--field <name>] [-H 'Name: value']"


def cmd_upload(env, args):
    """ファイルを multipart で送る（添付・写真・Bulk Write の CSV など）。フィールド名の既定は file。"""
    headers, args = take_headers(args)
    fields, args = take_values(args, "--field")
    if len(args) != 2:
        die(UPLOAD_USAGE)
    path, src = args
    try:
        with open(os.path.expanduser(src), "rb") as f:
            data = f.read()
    except OSError as e:
        die(f"{src} を読めません: {e.strerror}")
    if not data:
        die(f"{src} が空です")
    ctype = mimetypes.guess_type(src)[0] or "application/octet-stream"
    body, content_type = multipart(fields[-1] if fields else "file", os.path.basename(src), data, ctype)
    url, resp_headers, raw = send(env, "POST", path, data=body, content_type=content_type,
                                  headers=headers)
    res = decode_json("POST", url, resp_headers, raw)
    print(json.dumps(res, ensure_ascii=False, indent=2))
    check_write_result(res)


COQL_PAGE = 200
COQL_USAGE = "usage: zoho coql [--all] \"select ... from Accounts where ...\""


def cmd_coql(env, args):
    fetch_all, args = take_flag(args, "--all")
    if len(args) != 1:
        die(COQL_USAGE)
    query = args[0].strip().rstrip(";")
    if not fetch_all:
        res = call(env, "POST", "coql", body={"select_query": query})
        print(json.dumps(res, ensure_ascii=False, indent=2))
        # 1 回 200 件が上限。黙って上限で切れたと思わせない
        if (res.get("info") or {}).get("more_records"):
            incomplete("COQL は 1 回 200 件までです。--all で全件取るか、LIMIT / OFFSET で分けてください")
        return
    if re.search(r"\b(limit|offset)\b", query, re.I):
        die("--all は LIMIT / OFFSET を自分で付けたクエリには使えません")
    # ORDER BY が無いと、ページをまたいで行が重複・欠落しうる
    if not re.search(r"\border\s+by\b", query, re.I):
        print("# ORDER BY が無いので、ページ境界で行が重複・欠落する恐れがあります"
              "（`order by id` を付けると安定します）", file=sys.stderr)
    rows, offset = [], 0
    while True:
        res = call(env, "POST", "coql",
                   body={"select_query": f"{query} limit {COQL_PAGE} offset {offset}"})
        chunk = res.get("data")
        if not isinstance(chunk, list):
            # 該当 0 件は 204 で本文が空になる。それ以外は取れなかった
            if rows or res == {}:
                break
            incomplete(f"data がありません。{len(rows)} 件で打ち切りました")
            break
        rows.extend(chunk)
        if not (res.get("info") or {}).get("more_records"):
            break
        offset += COQL_PAGE
        print(f"  ... {len(rows)} 件", file=sys.stderr)
    print(json.dumps({"data": rows, "info": {"count": len(rows)}}, ensure_ascii=False, indent=2))


FN_USAGE = ("usage: zoho fn pull <id|api_name>\n"
            "       zoho fn push <id|api_name> <file.ds> [--base <file.ds>]")


def function_path(ident, suffix=""):
    return f"settings/functions/{urllib.parse.quote(ident, safe='')}{suffix}"


def fetch_code(env, ident):
    """関数のコードを (ファイル名, バイト列) で返す。Deluge は .ds、それ以外は zip。"""
    url, headers, raw = send(env, "GET", function_path(ident, "/code"))
    name = headers.get_filename()
    # 200 でも途中の機器が HTML を差し込むことがある。添付で返らなければコードとして扱わない
    if not name:
        die(f"GET {url} -> 関数のコードが返りませんでした: "
            f"{raw[:300].decode(errors='replace')}")
    return name, raw


def read_deluge(path):
    try:
        with open(os.path.expanduser(path), "rb") as f:
            data = f.read()
    except OSError as e:
        die(f"{path} を読めません: {e.strerror}")
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        die(f"{path} が UTF-8 ではありません")
    if not data.strip():
        die(f"{path} が空です")
    return data


def multipart(name, filename, data, content_type="application/octet-stream"):
    boundary = uuid.uuid4().hex
    filename = filename.replace("\\", "_").replace('"', "_").replace("\r", "_").replace("\n", "_")
    body = (f"--{boundary}\r\n"
            f'Content-Disposition: form-data; name="{name}"; filename="{filename}"\r\n'
            f"Content-Type: {content_type}\r\n\r\n").encode() \
        + data + f"\r\n--{boundary}--\r\n".encode()
    return body, f"multipart/form-data; boundary={boundary}"


def same_code(a, b):
    """保存時に Zoho が末尾の改行を落とすので、そこだけ揃えて比べる。
    揃えないと、エディタが末尾に改行を足したファイルを push したとき、公開まで
    済んでいるのに読み直しで失敗し、しかも行単位の差分には何も出ない。"""
    return a.rstrip(b"\r\n") == b.rstrip(b"\r\n")


def cmd_fn_push(env, args):
    """Deluge 関数のコードを差し替え、読み直して送った内容と一致するか確かめる。

    Deluge は PUT した時点で公開され、下書きの段階が無い。構文の誤りは
    COMPILATION_ERROR で拒否されるが、意味の誤りはそのまま本番で動く。
    引数の宣言もコードの 1 行目から読み直されるので、変えると呼び出し元の
    ワークフローが渡す引数とずれる。

    --base は、手元で直し始めたときの版。今のコードがそれと違えば送らない。
    画面のエディタで誰かが直した分を、古い版から作った差分で黙って潰さないため。
    """
    base = None
    if "--base" in args:
        i = args.index("--base")
        if i + 1 >= len(args):
            die(FN_USAGE)
        base = read_deluge(args[i + 1])
        args = args[:i] + args[i + 2:]
    if len(args) != 2:
        die(FN_USAGE)
    ident, path = args
    code = read_deluge(path)
    filename, current = fetch_code(env, ident)
    if not filename.endswith(".ds"):
        die(f"{ident} は Deluge の関数ではありません（{filename}）。push は Deluge だけです")
    if base is not None and not same_code(current, base):
        die(f"{ident} の今のコードが --base と違います。画面で直された可能性があるので、"
            "取り直してから直してください")
    body, ctype = multipart("code", filename, code)
    url, headers, raw = send(env, "PUT", function_path(ident), data=body, content_type=ctype)
    res = decode_json("PUT", url, headers, raw)
    rows = res.get("functions") if isinstance(res, dict) else None
    row = rows[0] if isinstance(rows, list) and rows and isinstance(rows[0], dict) else {}
    if str(row.get("status", "")).lower() != "success":
        die(f"PUT {url} -> 更新できませんでした: {json.dumps(res, ensure_ascii=False)[:1000]}")
    # Zoho は書けていなくても SUCCESS を返すことがあるので、応答ではなく読み直しで判定する
    _, after = fetch_code(env, ident)
    if not same_code(after, code):
        diff = difflib.unified_diff(
            code.decode().splitlines(), after.decode(errors="replace").splitlines(),
            "送った内容", "読み直した内容", lineterm="")
        print("\n".join(list(diff)[:60]), file=sys.stderr)
        die(f"{ident} を読み直した内容が送った内容と違います")
    note = "（内容は変わっていません）" if same_code(current, code) else ""
    print(f"ok: {ident} を更新しました{note}")


def cmd_fn(env, args):
    if args[:1] == ["pull"] and len(args) == 2:
        _, code = fetch_code(env, args[1])
        sys.stdout.buffer.write(code)
    elif args[:1] == ["push"]:
        cmd_fn_push(env, args[1:])
    else:
        die(FN_USAGE)


def cmd_init():
    # CONFIG_DIR を作らないまま open すると、新しいマシンでは README の手順 1 が
    # FileNotFoundError で落ちる
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    secure(CONFIG_DIR, 0o700)
    if os.path.exists(ENV_PATH):
        secure(ENV_PATH, 0o600)
        print(f"既に {ENV_PATH} があります")
        return
    # exists と open("w") を分けると、その隙に作られた env を切り詰めて
    # client_secret を失う。O_EXCL で名前の確保ごと不可分にする
    fd = os.open(ENV_PATH, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(
            "# https://api-console.zoho.jp/ の Self Client で発行した値\n"
            "ZOHO_CLIENT_ID=\n"
            "ZOHO_CLIENT_SECRET=\n"
            "ZOHO_DC=jp\n"
        )
    print(f"{ENV_PATH} を作成しました。CLIENT_ID / CLIENT_SECRET を記入してください")


USAGE = """usage:
  zoho init                              設定ファイルの雛形を作る
  zoho auth <grant_token>                Self Client の grant token を交換して保存
  zoho revoke <refresh_token | ->        refresh_token を 1 本失効させる (- は標準入力。
                                         tokens.json の分は -y が要る)
  zoho token                             アクセストークンを更新して状態を表示
  zoho get <path> [k=v ...] [--all]      GET (--all で全ページ取得)
           [-H 'Name: value'] [-o <file | -> [-y]]
                                         -H はヘッダ追加（If-Modified-Since など。304 は exit 0）。
                                         -o は JSON 以外（添付・Bulk の zip）をそのまま保存
  zoho post|put|patch|delete <path> [@file | - | '<json>'] [-H 'Name: value']
  zoho upload <path> <file> [--field <name>] [-H 'Name: value']
                                         multipart で送る（添付・写真・Bulk Write の CSV。
                                         content.zohoapis.* にも送れる）
  zoho coql [--all] "<select_query>"     COQL クエリ (--all は LIMIT/OFFSET を自動で回す)
  zoho fn pull <id|api_name>             関数のコードを標準出力へ (Deluge は .ds、他は zip)
  zoho fn push <id|api_name> <file.ds> [--base <file.ds>]
                                         Deluge 関数を差し替えて読み直す (即公開。--base と
                                         今のコードが違えば送らない)

path は crm/v8 が補われる (例: `zoho get Contracts fields=field11 per_page=200 --all`)。
`settings/fields?module=Contracts` のように settings 配下もそのまま書ける。"""


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "init":
        cmd_init()
        return
    env = load_env()
    if cmd == "auth":
        cmd_auth(env, args)
    elif cmd == "revoke":
        cmd_revoke(env, args)
    elif cmd == "token":
        t = access_token(env, force=True)
        print(f"ok: 有効期限 {time.strftime('%H:%M:%S', time.localtime(t['expires_at']))} / api_domain={t.get('api_domain')}")
    elif cmd == "get":
        cmd_get(env, args)
    elif cmd in ("post", "put", "patch", "delete"):
        cmd_write(env, cmd.upper(), args)
    elif cmd == "coql":
        cmd_coql(env, args)
    elif cmd == "upload":
        cmd_upload(env, args)
    elif cmd == "fn":
        cmd_fn(env, args)
    else:
        die(f"未知のコマンド: {cmd}\n\n{USAGE}")
    if _incomplete:
        die(f"取り切れませんでした（{_incomplete}）。出力は途中までです")


if __name__ == "__main__":
    main()
