def main():
    argv = split_global(sys.argv[1:])
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "manifest":
        return cmd_manifest(args)
    if cmd == "login":
        return cmd_login(args)
    if cmd == "profile":
        return cmd_profile(args)
    if cmd == "api" and args and args[0] in ("help", "-h", "--help"):
        return cmd_api(None, args)
    prof = Profile(active_name())
    table = {"search": cmd_search, "ask": cmd_ask, "channels": cmd_channels, "users": cmd_users,
             "members": cmd_members, "history": cmd_history, "thread": cmd_thread,
             "read": cmd_read, "cache": cmd_cache, "whoami": cmd_whoami, "api": cmd_api}
    if cmd not in table:
        die(f"未知のコマンド: {cmd}\n\n{USAGE}")
    table[cmd](prof, args)


def split_global(argv):
    spec = {"--profile": True, "--json": False, "--raw": False, "--quiet": False}
    keep, i = [], 0
    while i < len(argv):
        a = argv[i]
        key, inline = (a.split("=", 1) + [None])[:2]
        if key in spec:
            if spec[key]:
                if inline is None:
                    i += 1
                    if i >= len(argv):
                        die(f"{key} には値が必要です")
                    inline = argv[i]
                G[key] = inline
            else:
                G[key] = True
        else:
            keep.append(a)
        i += 1
    return keep


