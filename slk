def _peek(path):
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        return {}


def load_app():
    """OAuth アプリの設定。個人の設定ディレクトリ → スクリプトと同じ場所（＝リポジトリ）の順。

    リポジトリ側は配布される共有の既定値なので、個人の上書きが勝つ向きにする。
    値が空のものは「未記入のひな型」として次の候補へ進む。"""
    here = os.path.dirname(os.path.realpath(__file__))
    blank = []
    for path in (os.path.join(CONFIG_ROOT, "app.json"), os.path.join(here, "app.json")):
        if not os.path.exists(path):
            continue
        try:
            blob = json.load(open(path))
        except ValueError as e:
            die(f"{path} が JSON として読めません: {e}")
        if blob.get("client_id") and blob.get("redirect_uri"):
            return blob, path
        blank.append(path)
    if blank:
        missing = [k for k in ("client_id", "redirect_uri") if not _peek(blank[0]).get(k)]
        die(f"{blank[0]} の {' と '.join(missing)} が空です。\n"
            "    client_id は Slack アプリの Basic Information、\n"
            "    redirect_uri は OAuth & Permissions に登録した Redirect URL（末尾スラッシュまで一致）")
    die(f"app.json がありません（{os.path.join(CONFIG_ROOT, 'app.json')} を作るか、"
        "リポジトリ同梱のものを記入してください）")


def secret_account(app):
    return f"{APP_SECRET_PREFIX}.{app['client_id']}"


def app_secret(app, reset=False):
    acct = secret_account(app)
    if not reset:
        sec = keychain_get(acct) if keychain_ok() else None
        if sec:
            return sec
    if not sys.stdin.isatty():
        die(f"client_secret が Keychain（account={acct}）にありません。"
            "対話環境で slk login を 1 度実行してください")
    note("アプリの client_secret を登録します（Keychain に入り、次回から聞きません）")
    note("入れ直したいときは slk login --reset-secret")
    sec = getpass.getpass("client_secret: ").strip()
    if not sec:
        die("client_secret が空です")
    if keychain_ok():
        ok, err = keychain_set(acct, sec)
        if not ok:
            warn(f"Keychain に保存できませんでした（今回だけ使います）: {err}")
    return sec


def oauth_exchange(app, secret, code):
    body = urllib.parse.urlencode({
        "client_id": app["client_id"], "client_secret": secret,
        "code": code, "redirect_uri": app["redirect_uri"]}).encode()
    req = urllib.request.Request("https://slack.com/api/oauth.v2.access", data=body, method="POST")
    req.add_header("Content-Type", "application/x-www-form-urlencoded")
    req.add_header("User-Agent", USER_AGENT)
    try:
        with urllib.request.urlopen(req) as res:
            blob = json.loads(res.read().decode())
    except urllib.error.HTTPError as e:
        die(f"oauth.v2.access -> HTTP {e.code} {e.read().decode()[:300]}")
    if not blob.get("ok"):
        return None, blob.get("error", "?")
    token = (blob.get("authed_user") or {}).get("access_token")
    if not token:
        die("user token が返りませんでした（認可 URL の user_scope を確認してください）")
    return token, None


class _Catcher(http.server.BaseHTTPRequestHandler):
    """着地ページの JS から投げ返される 1 リクエストだけを拾う。"""
    result = None

    def do_GET(self):
        q = {k: v[0] for k, v in
             urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query).items()}
        if "code" not in q and "error" not in q:
            self.send_response(404)
            self.end_headers()
            return
        _Catcher.result = q
        page = ("<!doctype html><meta charset=utf-8><title>slk</title>"
                "<p style='font:16px system-ui;padding:2rem'>"
                "認証できました。ターミナルに戻ってください。</p>").encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(page)))
        self.end_headers()
        self.wfile.write(page)

    def log_message(self, *a):
        pass


def serve_once(srv, timeout):
    _Catcher.result = None
    srv.timeout = 1
    deadline = time.time() + timeout
    while time.time() < deadline and _Catcher.result is None:
        srv.handle_request()
    srv.server_close()
    return _Catcher.result


def parse_pasted(raw):
    raw = raw.strip()
    if not raw:
        die("入力が空です")
    if raw.startswith("http") or "?" in raw:
        return {k: v[0] for k, v in
                urllib.parse.parse_qs(urllib.parse.urlsplit(raw).query).items()}
    return {"code": raw}


def install_token(name, token, auth, quiet=False):
    """プロファイルを作ってトークンを保存する。profile add と login の共通処理。"""
    dir_ = profile_dir(name)
    os.makedirs(os.path.join(dir_, "cache"), exist_ok=True)
    os.chmod(PROFILE_ROOT, 0o700)
    os.chmod(dir_, 0o700)
    stored, err = keychain_set(name, token) if keychain_ok() else (False, "macOS の security が使えません")
    if stored:
        write_env_stub(dir_)
        if not quiet:
            print(f"トークンは Keychain に保存しました（service={KEYCHAIN_SERVICE} / account={name}）")
    else:
        env_path = os.path.join(dir_, "env")
        with open(env_path, "w") as f:
            f.write(f"SLACK_USER_TOKEN={token}\n")
        os.chmod(env_path, 0o600)
        warn(f"Keychain に保存できなかったので {env_path} に平文で置きました: {err}")
    blob = save_team(dir_, auth)
    with open(os.path.join(dir_, ".label"), "w") as f:
        f.write(f"{blob['team']} ({blob['user']})\n")
    if not os.path.exists(ACTIVE_FILE):
        os.makedirs(CONFIG_ROOT, exist_ok=True)
        with open(ACTIVE_FILE, "w") as f:
            f.write(name + "\n")
        print(f"有効なプロファイルにしました（切り替えは slk profile use <name>）")
    return blob


def cmd_login(args):
    opts, rest = take_opts(args, {"--manual": False, "--timeout": True, "--reset-secret": False})
    app, app_path = load_app()
    secret = app_secret(app, reset=bool(opts.get("--reset-secret")))
    nonce = secrets.token_urlsafe(16)

    srv = None
    if not opts.get("--manual"):
        try:
            srv = http.server.HTTPServer(("127.0.0.1", 0), _Catcher)
        except OSError as e:
            warn(f"ローカルの受け口を開けませんでした（貼り付け方式にします）: {e}")
    # 着地ページは state の先頭からポートを読んでここへ投げ返す。0 なら貼り付け方式
    state = f"{srv.server_port if srv else 0}.{nonce}"
    url = AUTHORIZE_URL + "?" + urllib.parse.urlencode({
        "client_id": app["client_id"],
        "user_scope": ",".join(app.get("user_scopes") or USER_SCOPES),
        "redirect_uri": app["redirect_uri"],
        "state": state})

    note(f"設定: {app_path}")
    note("ブラウザで承認してください。開かない場合は次の URL を開いてください:")
    print(url, file=sys.stderr)
    try:
        webbrowser.open(url)
    except Exception:
        pass

    got = None
    if srv:
        got = serve_once(srv, int(opts.get("--timeout", 300)))
        if got is None:
            warn("ブラウザから自動で受け取れませんでした。貼り付けに切り替えます")
    if got is None:
        if not sys.stdin.isatty():
            die("対話環境ではないので貼り付けができません")
        got = parse_pasted(input("着地したページの URL（または code）を貼ってください: "))

    if got.get("error"):
        die(f"承認されませんでした: {got['error']}")
    if "state" in got:
        if got["state"] != state:
            die("state が一致しません。別の認証の応答かもしれないので中断しました")
    else:
        warn("state を検証できませんでした（code だけを貼った場合はこの警告が出ます）")
    if not got.get("code"):
        die("code が取れませんでした")

    token, err = oauth_exchange(app, secret, got["code"])
    if err in BAD_SECRET_ERRORS:
        # 誤入力・ローテーション後の古い値が Keychain に残っているケース。
        # 入れ直して同じ code でもう 1 度だけ試す（失敗した交換では code は消費されない）
        warn(f"client_secret が受け付けられませんでした（{err}）")
        if not sys.stdin.isatty():
            die("対話環境で slk login --reset-secret を実行して入れ直してください")
        secret = app_secret(app, reset=True)
        token, err = oauth_exchange(app, secret, got["code"])
    if err:
        hints = {
            "invalid_code": "コードは 1 度きり・数分で失効します。slk login からやり直してください",
            "bad_redirect_uri": "app.json の redirect_uri が Slack 側の登録と完全一致していません",
            "invalid_client_id": "app.json の client_id が違います",
            "bad_client_secret": "slk login --reset-secret で入れ直してください",
        }
        die(f"トークン交換に失敗しました: {err}" + (f"（{hints[err]}）" if err in hints else ""))
    auth = call(token, "auth.test")
    name = rest[0] if rest else None
    if not name:
        m = re.match(r"https?://([^./]+)\.slack\.com", auth.get("url") or "")
        name = m.group(1) if m else "default"
    if not NAME_RE.match(name):
        die(f"プロファイル名に使えない文字が含まれています: {name}")
    existing = os.path.isdir(os.path.join(PROFILE_ROOT, name))
    blob = install_token(name, token, auth)
    print(f"プロファイル '{name}' を{'更新' if existing else '作成'}しました: "
          f"{blob['team']} / {blob['user']}")


def cmd_manifest(args):
    opts, _ = take_opts(args, {"--name": True, "--search": True})
    scopes = list(USER_SCOPES)
    mode = opts.get("--search", "both")
    if mode == "legacy":
        scopes = [s for s in scopes if not s.startswith("search:read.")]
    elif mode == "rts":
