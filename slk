def cmd_api(prof, args):
    opts, rest = take_opts(args, {"--all": False, "--key": True})
    if not rest or rest[0] in ("help", "-h", "--help"):
        print("usage: slk api <method> [key=value ...] [--all] [--key <一覧のキー>]\n\n呼べるメソッド:")
        for m in sorted(READ_METHODS):
            print("  " + m)
        return
    method, params = rest[0], {}
    for a in rest[1:]:
        if "=" not in a:
            die(f"不正な引数: {a}（key=value 形式）")
        k, v = a.split("=", 1)
        params[k] = v
    if not opts.get("--all"):
        out_json(prof.call(method, params))
        return
    key = opts.get("--key")
    if not key:
        probe = prof.call(method, dict(params, limit=params.get("limit", 200)))
        key = next((k for k, v in probe.items() if isinstance(v, list)), None)
        if not key:
            out_json(probe)
            return
    rows = paginate(prof, method, dict(params, limit=params.get("limit", 200)), key)
    out_json({key: rows, "count": len(rows)})


