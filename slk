        note("scope の組み合わせが拒否されたら --search legacy か --search rts で作り直す")


def cmd_profile(args):
    sub = (args[0] if args else "list")
    rest = args[1:]

    if sub in ("list", "ls"):
        names = list_profiles()
        if not names:
            print("プロファイルがありません（slk manifest → slk profile add <name>）")
            return
        active = None
        if os.path.exists(ACTIVE_FILE):
            active = open(ACTIVE_FILE).readline().strip()
        elif len(names) == 1:
            active = names[0]
        for n in names:
            label_path = os.path.join(PROFILE_ROOT, n, ".label")
            label = open(label_path).readline().strip() if os.path.exists(label_path) else ""
            where = token_where(n)
            if where is None:
                label = (label + " (未認証)").strip()
            elif where == "file":
                label = (label + " (トークンが平文ファイル: slk profile keychain " + n + ")").strip()
            print(f"{'*' if n == active else ' '} {n:<12} {label}")
        return

    if sub == "current":
        print(active_name())
        return

    if sub == "use":
        if not rest:
            die("usage: slk profile use <name>")
        name = rest[0]
        if not os.path.isdir(profile_dir(name)):
            die(f"プロファイル '{name}' がありません")
        os.makedirs(CONFIG_ROOT, exist_ok=True)
        with open(ACTIVE_FILE, "w") as f:
            f.write(name + "\n")
        print(f"有効なプロファイル: {name}")
        if os.environ.get("SLK_PROFILE"):
            warn(f"環境変数 SLK_PROFILE={os.environ['SLK_PROFILE']} が優先されます")
        return

    if sub == "add":
        if not rest:
            die("usage: slk profile add <name>   (トークンは標準入力から読みます)")
        name = rest[0]
        dir_ = profile_dir(name)
        if os.path.exists(dir_):
            die(f"プロファイル '{name}' は既にあります")
        token = os.environ.get("SLK_TOKEN")
        if not token:
            if sys.stdin.isatty():
                token = getpass.getpass("User OAuth Token (xoxp-…): ").strip()
            else:
                token = sys.stdin.read().strip()
        if not token.startswith("xox"):
            die("Slack のトークンに見えません（xoxp- で始まる User OAuth Token）")
        if token.startswith("xoxb-"):
            die("bot token では検索できません。User OAuth Token (xoxp-) を使ってください")
        auth = call(token, "auth.test")
        blob = install_token(name, token, auth)
        print(f"プロファイル '{name}' を作成しました: {blob['team']} / {blob['user']}")
        return

    if sub == "label":
        if not rest:
            die("usage: slk profile label <name> [表示テキスト]")
        name, text = rest[0], " ".join(rest[1:])
        dir_ = profile_dir(name)
        if not os.path.isdir(dir_):
            die(f"プロファイル '{name}' がありません")
        if not text:
            auth = call(Profile(name).token, "auth.test")
            blob = save_team(dir_, auth)
            text = f"{blob['team']} ({blob['user']})"
        with open(os.path.join(dir_, ".label"), "w") as f:
            f.write(text + "\n")
        print(f"{name}: {text}")
        return

    if sub == "keychain":
        opts, pos = take_opts(rest, {"--force": False})
        name = pos[0] if pos else active_name()
        dir_ = profile_dir(name)
        if not os.path.isdir(dir_):
            die(f"プロファイル '{name}' がありません")
        if not keychain_ok():
            die("macOS の Keychain が使えません（security コマンドが見つかりません）")
        token, existing = file_token(dir_), keychain_get(name)
        if existing and not token:
            print(f"'{name}': 既に Keychain にあります")
            return
        if existing and token:
            if existing == token:
                write_env_stub(dir_)
                print(f"'{name}': Keychain に同じ値があったので、env ファイルの平文を消しました")
                return
            # Keychain の鍵に設定ディレクトリが入らないので、別の設定ディレクトリの同名
            # プロファイルや失効済みの古い値が居座っていることがある。どちらが正しいかは
            # ここでは判定できないので、消さずに止める
            if not opts.get("--force"):
                die(f"'{name}': Keychain の値と env ファイルの値が違います。\n"
                    f"    どちらが有効かはここでは判定できないので、平文は消していません。\n"
                    f"    env の値で Keychain を上書きしてよければ: "
                    f"slk profile keychain {name} --force\n"
                    f"    Keychain 側を残すなら env から SLACK_USER_TOKEN の行を消してください")
            warn(f"'{name}': Keychain の既存の値を env ファイルの値で上書きします")
        if not token:
            die(f"'{name}' に移せるトークンがありません（slk profile add {name} で登録）")
        stored, err = keychain_set(name, token)
        if not stored:
            die(f"Keychain に保存できませんでした: {err}")
        if keychain_get(name) != token:
            die("Keychain に書いた値を読み戻せませんでした。env ファイルはそのままにしています")
        write_env_stub(dir_)
        print(f"'{name}' のトークンを Keychain に移しました"
              f"（service={KEYCHAIN_SERVICE} / account={name}）")
        sys.stdout.flush()
        note("env ファイルは上書きしましたが、ディスク上の旧データが残る可能性はあります。")
        note("気になる場合は Slack 側でトークンを再発行してください。")
        return

    if sub == "path":
        print(profile_dir(rest[0] if rest else active_name()))
        return

    if sub in ("rm", "remove"):
        opts, pos = take_opts(rest, {"-f": False, "--yes": False})
        if not pos:
            die("usage: slk profile rm <name> [-f]")
        name = pos[0]
        dir_ = profile_dir(name)
        if not os.path.isdir(dir_):
            die(f"プロファイル '{name}' がありません")
        if not (opts.get("-f") or opts.get("--yes")):
            ans = input(f"{dir_} とトークンを削除します。よろしいですか? [y/N] ").strip().lower()
            if ans not in ("y", "yes"):
                die("中止しました")
        for root, dirs, files in os.walk(dir_, topdown=False):
            for f in files:
                os.remove(os.path.join(root, f))
            for d in dirs:
                os.rmdir(os.path.join(root, d))
        os.rmdir(dir_)
        if keychain_ok():
            keychain_del(name)
        if os.path.exists(ACTIVE_FILE) and open(ACTIVE_FILE).readline().strip() == name:
            os.remove(ACTIVE_FILE)
        print(f"プロファイル '{name}' を削除しました")
        return

    die(f"不明なサブコマンド: {sub}"
        "（slk profile list|current|use|add|keychain|label|path|rm）")


USAGE = """usage: slk [--profile <name>] [--json|--raw] [--quiet] <command>

  slk manifest [--search both|legacy|rts]   アプリ作成用の manifest を出す
  slk login [<profile 名>] [--manual] [--reset-secret]
                                            ブラウザで承認して自分のトークンを取る
