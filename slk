def parse_url(url):
    m = ARCHIVE_RE.search(url)
    if not m:
        return None
    cid, ts = m.group(1), f"{m.group(2)}.{m.group(3)}"
    qs = urllib.parse.parse_qs(urllib.parse.urlsplit(url).query)
    return cid, ts, (qs.get("thread_ts") or [None])[0]


def cmd_thread(prof, args):
    if not args:
        die("usage: slk thread <permalink> | slk thread <#channel> <ts>")
    parsed = parse_url(args[0])
    if parsed:
        cid, ts, thread_ts = parsed
        ts = thread_ts or ts
    else:
        if len(args) < 2:
            die("usage: slk thread <#channel> <ts>")
        cid, ts = prof.resolve_channel(args[0]), args[1]
    prof.banner()
    res = prof.call("conversations.replies", {"channel": cid, "ts": ts, "limit": 200})
    if G.get("--raw"):
        out_json(res)
        return
    msgs = res.get("messages") or []
    name = prof.display_channel(cid)
    if G.get("--json"):
        out_json([msg_dict(prof, m, cid, name) for m in msgs])
        return
    note(f"{name}: スレッド {len(msgs)} 件")
    for i, m in enumerate(msgs):
        print_message(prof, m, channel=None, indent="" if i == 0 else "  ",
                      link=prof.permalink(cid, m.get("ts"), ts) if i == 0 else None)


def cmd_read(prof, args):
    opts, rest = take_opts(args, {"--context": True, "--thread": False})
    if not rest:
        die("usage: slk read <slack の URL> [--context N]")
    parsed = parse_url(rest[0])
    if not parsed:
        die("Slack のメッセージ URL ではありません（…/archives/C…/p… の形）")
    cid, ts, thread_ts = parsed
    n = int(opts.get("--context", 0))
    prof.banner()
    res = prof.call("conversations.history",
                    {"channel": cid, "latest": ts, "oldest": ts, "inclusive": True, "limit": 1})
    target = (res.get("messages") or [None])[0]
    if target is None:
        die("メッセージが見つかりません（削除済みか、そのチャンネルを読む権限がない）")
    name = prof.display_channel(cid)
    before = prof.messages_before(cid, ts, n) if n else []
    after = prof.messages_after(cid, ts, n) if n else []
    if not human():
        payload = {"channel": name, "message": msg_dict(prof, target, cid, name),
                   "before": [msg_dict(prof, m, cid, name) for m in before],
                   "after": [msg_dict(prof, m, cid, name) for m in after]}
        if G.get("--raw"):
            payload["raw"] = target
        out_json(payload)
        return
    note(f"{name}")
    for m in before:
        print_message(prof, m, indent="  ")
    print_message(prof, target, link=prof.permalink(cid, ts, thread_ts))
    for m in after:
        print_message(prof, m, indent="  ")
    if target.get("reply_count") or thread_ts:
        root = thread_ts or target.get("thread_ts") or ts
        replies = prof.call("conversations.replies", {"channel": cid, "ts": root, "limit": 200})["messages"]
        note(f"スレッド {len(replies)} 件")
        for r in replies[1:]:
            print_message(prof, r, indent="    ")


