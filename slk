SYSTEM_SUBTYPES = ("channel_join", "channel_leave", "group_join", "group_leave")


def drop_system(msgs):
    return [m for m in msgs if m.get("subtype") not in SYSTEM_SUBTYPES]


def message_text(m):
    t = (m.get("text") or "").strip()
    if not t:
        for a in m.get("attachments") or []:
            t = (a.get("fallback") or a.get("text") or a.get("title") or "").strip()
            if t:
                break
    if not t and m.get("files"):
        t = "[ファイル] " + ", ".join(f.get("name") or "?" for f in m["files"])
    if not t and m.get("blocks"):
        t = "[本文なし（blocks のみ）]"
    return t


def author(prof, m):
    if m.get("username"):
        return m["username"]
    if m.get("user"):
        return prof.user_name(m["user"])
    if m.get("bot_id"):
        return prof.bot_name(m["bot_id"])
    return "?"


def print_message(prof, m, channel=None, link=None, indent=""):
    head = [x for x in (channel, fmt_ts(m.get("ts")), author(prof, m)) if x]
    print(indent + "  ".join(head))
    body = prof.expand(message_text(m))
    for line in (body.splitlines() or [""]):
        print(f"{indent}  {line}")
    n = m.get("reply_count")
    if n and m.get("thread_ts") == m.get("ts"):
        print(f"{indent}  ↳ スレッドに {n} 件の返信")
    if link:
        print(f"{indent}  {link}")
    print()


def msg_dict(prof, m, cid=None, channel=None, permalink=None):
    return {"channel": channel, "channel_id": cid,
            "ts": m.get("ts"), "time": fmt_ts(m.get("ts")),
            "user": author(prof, m), "user_id": m.get("user"),
            "text": prof.expand(message_text(m)),
            "thread_ts": m.get("thread_ts"), "reply_count": m.get("reply_count"),
            "permalink": permalink or (prof.permalink(cid, m.get("ts"), m.get("thread_ts")) if cid else None)}


