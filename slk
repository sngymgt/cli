def save_team(dir_, auth):
    domain = ""
    m = re.match(r"https?://([^./]+)\.slack\.com", auth.get("url") or "")
    if m:
        domain = m.group(1)
    blob = {"team": auth.get("team"), "team_id": auth.get("team_id"), "domain": domain,
            "user": auth.get("user"), "user_id": auth.get("user_id")}
    with open(os.path.join(dir_, "team.json"), "w") as f:
        json.dump(blob, f, ensure_ascii=False, indent=2)
    return blob


