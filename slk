def take_opts(args, spec):
    """spec は {"--flag": False, "--key": True}。オプションと位置引数に割る。"""
    opts, rest, i = {}, [], 0
    while i < len(args):
        a = args[i]
        if a == "--":
            rest.extend(args[i + 1:])
            break
        if a.startswith("-") and a != "-":
            key, inline = (a.split("=", 1) + [None])[:2]
            if key not in spec:
                die(f"不明なオプション: {key}")
            if spec[key]:
                if inline is None:
                    i += 1
                    if i >= len(args):
                        die(f"{key} には値が必要です")
                    inline = args[i]
                opts[key] = inline
            else:
                if inline is not None:
                    die(f"{key} は値を取りません")
                opts[key] = True
        else:
            rest.append(a)
        i += 1
    return opts, rest


def to_epoch(spec):
    """YYYY-MM-DD / YYYY-MM-DD HH:MM / epoch を秒に。"""
    spec = spec.strip()
    if re.fullmatch(r"\d{9,10}(\.\d+)?", spec):
        return float(spec)
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d", "%Y/%m/%d"):
        try:
            return datetime.strptime(spec, fmt).timestamp()
        except ValueError:
            pass
    die(f"日時として読めません: {spec}（YYYY-MM-DD か epoch）")


def fmt_ts(ts):
    try:
        return datetime.fromtimestamp(float(ts)).strftime("%Y-%m-%d %H:%M")
    except (TypeError, ValueError):
        return str(ts)


# --- transport --------------------------------------------------------------

_last_call = 0.0


def _http(method, verb, token, params):
    global _last_call
    flat = {}
    for k, v in (params or {}).items():
        if v is None:
            continue
        flat[k] = "true" if v is True else "false" if v is False else str(v)
    url = f"{API_BASE}/{method}"
    body = None
    if verb == "GET":
        if flat:
            url += "?" + urllib.parse.urlencode(flat)
    else:
        body = urllib.parse.urlencode(flat).encode()
    req = urllib.request.Request(url, data=body, method=verb)
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("User-Agent", USER_AGENT)
    if body is not None:
        req.add_header("Content-Type", "application/x-www-form-urlencoded")
    wait = MIN_INTERVAL - (time.time() - _last_call)
    if wait > 0:
        time.sleep(wait)
    _last_call = time.time()
    with urllib.request.urlopen(req) as res:
        return json.loads(res.read().decode())


def call(token, method, params=None, _verb=None, _tries=0):
    verb = _verb or READ_METHODS.get(method)
    if verb is None:
        die(f"{method} は read-only の allowlist にありません（slk api help で一覧）")
    try:
        res = _http(method, verb, token, params)
    except urllib.error.HTTPError as e:
        if e.code == 429 and _tries < MAX_RETRY:
            delay = int(e.headers.get("Retry-After") or 30)
            warn(f"{method}: レート制限。{delay}s 待って再試行します")
            time.sleep(delay + 1)
            return call(token, method, params, _verb, _tries + 1)
        die(f"{method} -> HTTP {e.code} {e.read().decode()[:500]}")
    except urllib.error.URLError as e:
        die(f"{method} -> 接続できません: {e.reason}")
    if res.get("ok"):
        return res
    err = res.get("error", "?")
    if err == "method_not_supported_for_http_method" and _tries == 0:
        return call(token, method, params, "POST" if verb == "GET" else "GET", 1)
    if err == "missing_scope":
        die(f"{method}: scope 不足。必要={res.get('needed')} / 現在={res.get('provided')}\n"
            f"    slk manifest の scope でアプリを更新し、ワークスペースに再インストールしてください")
    hints = {
        "invalid_auth": "トークンが無効です（slk profile add でやり直す）",
        "token_expired": "トークンの期限が切れています（slk profile add でやり直す）",
        "account_inactive": "アカウントが無効化されています",
        "not_allowed_token_type": "user token (xoxp-) が必要です。bot token では検索できません",
        "not_in_channel": "そのチャンネルに参加していないため読めません",
        "channel_not_found": "チャンネルが見つかりません（ID か、参加済みかを確認）",
        "ratelimited": "レート制限に掛かりました。少し待って再実行してください",
    }
    die(f"{method} -> {err}" + (f"（{hints[err]}）" if err in hints else ""))


# --- profile ----------------------------------------------------------------

def keychain_ok():
    return sys.platform == "darwin" and bool(shutil.which("security"))


def keychain_get(name):
    r = subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE,
                        "-a", name, "-w"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def keychain_set(name, token):
    """トークンを argv に置かない（ps から他プロセスに見える）。security は -w に値を
    渡さないと入力と確認の 2 回読むので、同じ値を 2 行流す。

    start_new_session は必須。security は制御端末があると stdin ではなく /dev/tty から
    読むので、これを外すと対話シェルから実行したときだけ
    「password data for new item:」で無言のまま止まる。"""
    r = subprocess.run(["security", "add-generic-password", "-s", KEYCHAIN_SERVICE,
                        "-a", name, "-U", "-w"],
                       input=f"{token}\n{token}\n", capture_output=True, text=True,
                       start_new_session=True)
    return r.returncode == 0, (r.stderr or "").strip()


def keychain_del(name):
    subprocess.run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", name],
                   capture_output=True)


def file_token(dir_):
    path = os.path.join(dir_, "env")
    if not os.path.exists(path):
        return None
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line.startswith("SLACK_USER_TOKEN="):
                tok = line.split("=", 1)[1].strip().strip('"').strip("'")
                if tok:
                    return tok
    return None


def token_where(name):
    """そのプロファイルのトークンがどこにあるか。None なら未認証。"""
    if keychain_ok() and keychain_get(name):
        return "keychain"
    if file_token(os.path.join(PROFILE_ROOT, name)):
        return "file"
    return None


