def cmd_search(prof, args):
    opts, rest = take_opts(args, {"--in": True, "--from": True, "--after": True, "--before": True,
                                  "--on": True, "--limit": True, "--all": False, "--sort": True,
                                  "--asc": False, "--files": False})
    if not rest:
        die('usage: slk search "<query>" [--in #ch] [--from @user] [--after YYYY-MM-DD] [--limit N|--all]')
    q = " ".join(rest)
    if opts.get("--in"):
        v = opts["--in"]
        q += " in:" + (f"<#{v}>" if ID_RE.match(v) else v if v.startswith(("#", "@", "<")) else "#" + v)
    if opts.get("--from"):
        v = opts["--from"]
        q += " from:" + (f"<@{v}>" if ID_RE.match(v) else v if v.startswith(("@", "<")) else "@" + v)
    for flag, op in (("--after", "after"), ("--before", "before"), ("--on", "on")):
        if opts.get(flag):
            q += f" {op}:{opts[flag]}"

    method = "search.files" if opts.get("--files") else "search.messages"
    key = "files" if opts.get("--files") else "messages"
    want = None if opts.get("--all") else int(opts.get("--limit", 20))
    params = {"query": q, "sort": opts.get("--sort", "score"),
              "sort_dir": "asc" if opts.get("--asc") else "desc", "highlight": False}

    prof.banner()
    matches, page, total, pages = [], 1, None, 1
    while True:
        params["count"] = min(100, want - len(matches)) if want else 100
        params["page"] = page
        res = prof.call(method, params)
        block = res.get(key) or {}
        total = block.get("total")
        pages = (block.get("paging") or {}).get("pages") or 1
        matches.extend(block.get("matches") or [])
        if G.get("--raw") and page == 1 and not opts.get("--all"):
            out_json(res)
            return
        if want and len(matches) >= want:
            matches = matches[:want]
            break
        if page >= pages:
            break
        page += 1
        note(f"{len(matches)} 件 …")

    if G.get("--raw"):
        out_json({"query": q, "total": total, "matches": matches})
        return
    if opts.get("--files"):
        rows = [{"name": m.get("name"), "title": m.get("title"),
                 "user": m.get("username") or (prof.user_name(m["user"]) if m.get("user") else "?"),
                 "time": fmt_ts(m.get("timestamp")), "permalink": m.get("permalink")} for m in matches]
        if G.get("--json"):
            out_json(rows)
            return
        note(f"query: {q}  /  {len(rows)} 件 (全 {total} 件)")
        for r in rows:
            print(f"{r['time']}  {r['user']}  {r['name']}\n  {r['permalink']}\n")
        return

    if G.get("--json"):
        out_json([msg_dict(prof, m, (m.get("channel") or {}).get("id"),
                           "#" + ((m.get("channel") or {}).get("name") or "?"), m.get("permalink"))
                  for m in matches])
        return
    note(f"query: {q}  /  {len(matches)} 件 (全 {total} 件)")
    for m in matches:
        ch = "#" + ((m.get("channel") or {}).get("name") or "?")
        print_message(prof, m, channel=ch, link=m.get("permalink"))


def cmd_ask(prof, args):
    opts, rest = take_opts(args, {"--in": True, "--limit": True, "--context": False,
                                  "--types": True, "--channels": True,
                                  "--after": True, "--before": True})
    if not rest:
        die('usage: slk ask "<キーワード>" [--in #ch] [--context] [--types messages,channels,files]\n'
            '    文章を丸ごと渡すと 0 件になる（キーワード一致のため）')
    params = {"query": " ".join(rest),
              "limit": min(20, int(opts.get("--limit", 20))),
              "content_types": opts.get("--types", "messages"),
              "include_context_messages": bool(opts.get("--context"))}
    if opts.get("--channels"):
        params["channel_types"] = opts["--channels"]
    if opts.get("--in"):
        params["context_channel_id"] = prof.resolve_channel(opts["--in"])
    for flag, name in (("--after", "after"), ("--before", "before")):
        if opts.get(flag):
            params[name] = int(to_epoch(opts[flag]))

    prof.banner()
    res = prof.call("assistant.search.context", params)
    if G.get("--raw"):
        out_json(res)
        return
    results = res.get("results") or {}
    msgs = results.get("messages") or []
    chans = results.get("channels") or []
    files = results.get("files") or []
    if G.get("--json"):
        out_json(results)
        return
    if not (msgs or chans or files):
        note("0 件（Real-time Search API の応答形が想定と違う場合は --raw で確認）")
        return
    for m in msgs:
        ch = m.get("channel_name")
        head = f"#{ch}" if ch and not str(ch).startswith("#") else (ch or "?")
        print(f"{head}  {fmt_ts(m.get('message_ts'))}  {m.get('author_name') or '?'}")
        for line in prof.expand(m.get("content") or "").splitlines() or [""]:
            print("  " + line)
        ctx = m.get("context_messages") or {}
        for side, label in (("before", "前"), ("after", "後")):
            for c in ctx.get(side) or []:
                who = c.get("author_name") or "?"
                print(f"    [{label}] {who}: {prof.expand(c.get('content') or '')[:200]}")
        if m.get("permalink"):
            print("  " + m["permalink"])
        print()
    for c in chans:
        print(f"#{c.get('name') or c.get('channel_name') or c.get('id')}  "
              f"{(c.get('description') or c.get('purpose') or '')[:100]}")
    for f in files:
        print(f"[ファイル] {f.get('name') or f.get('title')}  {f.get('permalink') or ''}")


def cmd_channels(prof, args):
    opts, rest = take_opts(args, {"--private": False, "--public": False, "--dm": False,
                                  "--archived": False, "--member": False, "--refresh": False,
                                  "--limit": True})
    prof.banner()
    items = prof.channel_index(refresh=opts.get("--refresh", False))
    needle = (rest[0].lstrip("#@").lower() if rest else "")
    kinds = set()
    if opts.get("--public"):
        kinds.add("public")
    if opts.get("--private"):
        kinds.add("private")
    if opts.get("--dm"):
        kinds |= {"im", "mpim"}
    rows = []
    for cid, r in items.items():
        if kinds and r.get("type") not in kinds:
            continue
        if not kinds and r.get("type") in ("im", "mpim"):
            continue
        if r.get("archived") and not opts.get("--archived"):
            continue
        if opts.get("--member") and not r.get("member"):
            continue
        name = prof.display_channel(cid, r)
        if needle and needle not in name.lower() and needle not in (r.get("topic") or "").lower():
            continue
        rows.append({"id": cid, "name": name, "type": r.get("type"),
                     "members": r.get("num"), "joined": bool(r.get("member")),
                     "archived": bool(r.get("archived")), "topic": r.get("topic") or ""})
    rows.sort(key=lambda r: r["name"])
    if opts.get("--limit"):
        rows = rows[:int(opts["--limit"])]
    if not human():
        out_json(rows)
        return
    note(f"{len(rows)} 件")
    width = max([len(r["name"]) for r in rows] + [10])
    for r in rows:
        marks = ("*" if r["joined"] else " ") + ("A" if r["archived"] else " ")
        num = f"{r['members']}名" if r["members"] is not None else ""
        print(f"{marks} {r['name']:<{width}}  {r['id']}  {r['type']:<7} {num:>7}  {r['topic'][:60]}")


def cmd_users(prof, args):
    opts, rest = take_opts(args, {"--email": True, "--refresh": False, "--bots": False,
                                  "--deleted": False, "--limit": True})
    prof.banner()
    if opts.get("--email"):
        u = prof.call("users.lookupByEmail", {"email": opts["--email"]})["user"]
