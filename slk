def profile_dir(name):
    if not NAME_RE.match(name or ""):
        die(f"プロファイル名に使えない文字が含まれています: {name}")
    return os.path.join(PROFILE_ROOT, name)


def list_profiles():
    if not os.path.isdir(PROFILE_ROOT):
        return []
    return sorted(n for n in os.listdir(PROFILE_ROOT)
                  if not n.startswith(".") and os.path.isdir(os.path.join(PROFILE_ROOT, n)))


def active_name():
    for src in (G.get("--profile"), os.environ.get("SLK_PROFILE")):
        if src:
            return src
    if os.path.exists(ACTIVE_FILE):
        with open(ACTIVE_FILE) as f:
            name = f.readline().strip()
        if name:
            return name
    names = list_profiles()
    if len(names) == 1:
        return names[0]
    if not names:
        die("プロファイルがありません（slk manifest → アプリ作成 → slk profile add <name>）")
    die("有効なプロファイルが未設定です（slk profile use <name>）")


class Profile:
    def __init__(self, name):
        self.name = name
        self.dir = profile_dir(name)
        if not os.path.isdir(self.dir):
            die(f"プロファイル '{name}' がありません（slk profile list）")
        self._token = None
        self._team = None
        self._users = None
        self._channels = None

    @property
    def token(self):
        if self._token is None:
            self._token = (keychain_get(self.name) if keychain_ok() else None) or file_token(self.dir)
            if not self._token:
                die(f"プロファイル '{self.name}' のトークンが Keychain にも "
                    f"{os.path.join(self.dir, 'env')} にもありません"
                    f"（slk profile add {self.name} で登録）")
        return self._token

    def call(self, method, params=None):
        return call(self.token, method, params)

    def team(self):
        if self._team is None:
            path = os.path.join(self.dir, "team.json")
            self._team = json.load(open(path)) if os.path.exists(path) else {}
        return self._team

    def domain(self):
        return self.team().get("domain") or "app"

    def banner(self):
        if G.get("--quiet") or not human():
            return
        t = self.team()
        who = t.get("user") or "?"
        note(f"workspace: {self.name} ({t.get('team', '?')} / {who})")

    # --- cache
    def _cache_path(self, kind):
        return os.path.join(self.dir, "cache", f"{kind}.json")

    def _cache_read(self, kind):
        path = self._cache_path(kind)
        if not os.path.exists(path):
            return {"ts": 0, "items": {}}
        try:
            blob = json.load(open(path))
        except ValueError:
            return {"ts": 0, "items": {}}
        blob.setdefault("ts", 0)
        blob.setdefault("items", {})
        return blob

    def _cache_write(self, kind, blob):
        path = self._cache_path(kind)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(blob, f, ensure_ascii=False)
        os.replace(tmp, path)

    def _merge(self, kind, key, value):
        """id 解決の 1 件を足すだけ。ts は動かさない（動かすと一覧が永久に再取得されない）。"""
        blob = self._cache_read(kind)
        blob["items"][key] = value
        self._cache_write(kind, blob)
        return value

    def user_index(self, refresh=False):
        if self._users is None or refresh:
            blob = self._cache_read("users")
            if refresh or time.time() - blob["ts"] > LIST_TTL:
                items = {}
                for u in paginate(self, "users.list", {"limit": 200}, "members"):
                    items[u["id"]] = user_row(u)
                blob = {"ts": time.time(), "items": items}
                self._cache_write("users", blob)
            self._users = blob["items"]
        return self._users

    def channel_index(self, refresh=False):
        if self._channels is None or refresh:
            blob = self._cache_read("channels")
            if refresh or time.time() - blob["ts"] > LIST_TTL:
                items = {}
                params = {"limit": 1000, "types": "public_channel,private_channel,mpim,im",
                          "exclude_archived": False}
                for c in paginate(self, "conversations.list", params, "channels"):
                    items[c["id"]] = channel_row(c)
                blob = {"ts": time.time(), "items": items}
                self._cache_write("channels", blob)
            self._channels = blob["items"]
        return self._channels

    def user_name(self, uid):
        items = self._users if self._users is not None else self._cache_read("users")["items"]
        row = items.get(uid)
        if row is None and not items:
            # 1 件も持っていない状態で 1 件ずつ users.info を叩くと DM 一覧だけで数十回になる
            row = self.user_index().get(uid)
        if row is None:
            try:
                row = user_row(self.call("users.info", {"user": uid})["user"])
            except SystemExit:
                return uid
            self._merge("users", uid, row)
            if self._users is not None:
                self._users[uid] = row
        return row.get("name") or uid

    def bot_name(self, bot_id):
        items = self._cache_read("bots")["items"]
        row = items.get(bot_id)
        if row is None:
            try:
                row = {"name": (self.call("bots.info", {"bot": bot_id})["bot"] or {}).get("name") or bot_id}
            except SystemExit:
                row = {"name": bot_id}
            self._merge("bots", bot_id, row)
        return row["name"]

    def channel_name(self, cid):
        items = self._channels if self._channels is not None else self._cache_read("channels")["items"]
        row = items.get(cid)
        if row is None and not items:
            row = self.channel_index().get(cid)
        if row is None:
            try:
                row = channel_row(self.call("conversations.info", {"channel": cid})["channel"])
            except SystemExit:
                return cid
            self._merge("channels", cid, row)
            if self._channels is not None:
                self._channels[cid] = row
        return self.display_channel(cid, row)

    def display_channel(self, cid, row=None):
        row = row or self._cache_read("channels")["items"].get(cid) or {}
        if row.get("type") == "im":
            return "@" + (self.user_name(row["user"]) if row.get("user") else cid)
        return "#" + (row.get("name") or cid)

    # --- 解決
    def resolve_user(self, spec):
        if ID_RE.match(spec):
            return spec
        if "@" in spec and "." in spec.split("@")[-1]:
            return self.call("users.lookupByEmail", {"email": spec})["user"]["id"]
        needle = spec.lstrip("@").lower()
        items = self.user_index()
        exact = [uid for uid, r in items.items()
                 if needle in (str(r.get("name", "")).lower(), str(r.get("real", "")).lower())]
        if len(exact) == 1:
            return exact[0]
        if len(exact) > 1:
            die("複数のユーザーが一致します: " + ", ".join(items[u]["name"] for u in exact[:10]))
        part = [uid for uid, r in items.items() if not r.get("deleted")
                and (needle in str(r.get("name", "")).lower() or needle in str(r.get("real", "")).lower())]
        if len(part) == 1:
            return part[0]
        if not part:
            die(f"ユーザーが見つかりません: {spec}")
        die("複数のユーザーが一致します: " + ", ".join(items[u]["name"] for u in part[:10]))

    def resolve_channel(self, spec):
        if ID_RE.match(spec):
            return spec
        if spec.startswith("@"):
            uid = self.resolve_user(spec)
            for cid, r in self.channel_index().items():
                if r.get("type") == "im" and r.get("user") == uid:
                    return cid
            die(f"{spec} との DM が見つかりません")
        needle = spec.lstrip("#").lower()
        items = self.channel_index()
        exact = [cid for cid, r in items.items() if str(r.get("name", "")).lower() == needle]
        if len(exact) == 1:
            return exact[0]
        part = [cid for cid, r in items.items() if needle in str(r.get("name", "")).lower()]
        if len(part) == 1:
            note(f"'{spec}' → {self.display_channel(part[0])}")
            return part[0]
        if not part:
            die(f"チャンネルが見つかりません: {spec}（slk cache refresh で一覧を更新）")
        die("複数のチャンネルが一致します: " + ", ".join(self.display_channel(c) for c in part[:10]))

    # --- 整形
    def expand(self, text):
        if not text:
            return ""
        def sub(m):
            kind, ident, label = m.group(1), m.group(2), m.group(3)
            if kind == "!":
                return "@" + (label.lstrip("@") if label else ident.split("^")[0])
            if label:
                return ("@" if kind == "@" else "#") + label.lstrip("@#")
            if kind == "@":
                return "@" + self.user_name(ident)
            return self.channel_name(ident)
        s = MENTION_RE.sub(sub, text)
        s = ANGLE_RE.sub(lambda m: m.group(2) or m.group(1), s)
        return html.unescape(s)

    def permalink(self, cid, ts, thread_ts=None):
        p = "p" + str(ts).replace(".", "")
        url = f"https://{self.domain()}.slack.com/archives/{cid}/{p}"
        if thread_ts and thread_ts != ts:
            url += f"?thread_ts={thread_ts}&cid={cid}"
        return url

    # --- 読み取り
    def messages_before(self, cid, ts, n):
        """ts より前の n 件（古い順）。入退室を落とした後の件数で数えるので、
        足りなければカーソルでさらに遡る。"""
        got, params = [], {"channel": cid, "latest": ts, "inclusive": False, "limit": max(n * 3, 30)}
        for _ in range(10):
            res = self.call("conversations.history", params)
            got.extend(drop_system(res.get("messages") or []))
            cursor = (res.get("response_metadata") or {}).get("next_cursor")
            if len(got) >= n or not res.get("has_more") or not cursor:
                break
            params["cursor"] = cursor
            # 入退室ばかりのチャンネルだと 1 ページの実収穫が数件になるので、遡るほど広く取る
            params["limit"] = min(1000, params["limit"] * 4)
        return list(reversed(got[:n]))

    def messages_after(self, cid, ts, n):
        """ts より後ろの n 件（古い順）。

        history は latest から過去へ向かってしか読めないので、[ts, ts+span] の窓を
        「取り切った」状態にしないと、返ってくるのは窓の中の**新しい方**の n 件になり、
        ts の直後の n 件にならない。has_more が立っている間は取り切れていないので
        件数を増やし、取り切ったうえで足りなければ窓を広げる。"""
        span, limit, got = 300, max(n * 3, 30), []
        for _ in range(10):
            res = self.call("conversations.history", {
                "channel": cid, "oldest": ts, "latest": float(ts) + span,
                "inclusive": False, "limit": limit})
            msgs = [m for m in (res.get("messages") or []) if float(m.get("ts", 0)) > float(ts)]
            if res.get("has_more"):
                if limit < 1000:
                    limit = min(1000, limit * 4)
                else:
                    span = max(60, span // 4)
                continue
            got = drop_system(list(reversed(msgs)))
            if len(got) >= n or span > 63072000:
                break
            span *= 6
        return got[:n]


def user_row(u):
    p = u.get("profile") or {}
    return {"name": u.get("name") or p.get("display_name") or u.get("id"),
            "real": p.get("real_name") or u.get("real_name") or "",
            "email": p.get("email") or "",
            "bot": bool(u.get("is_bot")) or u.get("id") == "USLACKBOT",
            "deleted": bool(u.get("deleted"))}


def channel_row(c):
    kind = ("im" if c.get("is_im") else "mpim" if c.get("is_mpim")
            else "private" if c.get("is_private") else "public")
    return {"name": c.get("name") or "", "type": kind,
            "archived": bool(c.get("is_archived")), "member": bool(c.get("is_member")),
            "num": c.get("num_members"), "user": c.get("user"),
            "topic": ((c.get("topic") or {}).get("value") or "")[:120]}


def paginate(prof, method, params, key, cap=None):
    """cursor 方式の一覧をまとめて取る。"""
    rows, params = [], dict(params)
    while True:
        res = prof.call(method, params)
        rows.extend(res.get(key) or [])
        if cap and len(rows) >= cap:
            return rows[:cap]
        cursor = (res.get("response_metadata") or {}).get("next_cursor")
        if not cursor:
            return rows
        params["cursor"] = cursor
        if len(rows) >= 1000:
            note(f"{method}: {len(rows)} 件 …")


