def as_json(data):
    """200 でも JSON とは限らない（キャプティブポータル・プロキシの HTML）。
    その場合に JSONDecodeError のトレースバックで落とさない。"""
    text = data.decode(errors="replace") if isinstance(data, bytes) else data
    try:
        return json.loads(text) if text.strip() else {}
    except ValueError:
        die(f"JSON が返りませんでした: {text[:300]}")


def opt_int(opts, name, default, minimum=1):
    """数値オプションを読む。打ち間違いを ValueError のトレースバックにしない。"""
    raw = opts.get(name, default)
    try:
        v = int(raw)
    except (TypeError, ValueError):
        die(f"{name} には整数を指定してください: {raw}")
    if v < minimum:
        die(f"{name} は {minimum} 以上で指定してください: {v}")
    return v


