def cmd_history(prof, args):
    opts, rest = take_opts(args, {"--limit": True, "--after": True, "--before": True, "--threads": False})
    if not rest:
        die("usage: slk history <#channel|@user> [--limit N] [--after YYYY-MM-DD] [--before ...]")
    cid = prof.resolve_channel(rest[0])
    limit = opt_int(opts, "--limit", 50)
    params = {"channel": cid, "limit": min(1000, limit)}
    if opts.get("--after"):
        params["oldest"] = to_epoch(opts["--after"])
    if opts.get("--before"):
        params["latest"] = to_epoch(opts["--before"])
    prof.banner()
    res = prof.call("conversations.history", params)
    if G.get("--raw"):
        out_json(res)
        return
    # drop_system は API の limit を掛けたあとに効くので、システムメッセージの多い
    # チャンネルでは要求より少なくなる。取り切れていないなら黙って返さない
    raw_msgs = res.get("messages") or []
    msgs = drop_system(list(reversed(raw_msgs)))[:limit]
    if len(msgs) < limit and res.get("has_more"):
        incomplete(f"{len(msgs)} 件しか取れませんでした（続きがあります）")
    name = prof.display_channel(cid)
    if G.get("--json"):
        if opts.get("--threads"):
            warn("--threads は --json では効きません（本文のみ出力します）")
        out_json([msg_dict(prof, m, cid, name) for m in msgs])
        return
    note(f"{name}: {len(msgs)} 件（古い順）")
    for m in msgs:
        print_message(prof, m, channel=None, link=prof.permalink(cid, m.get("ts")))
        if opts.get("--threads") and m.get("reply_count"):
            _r = prof.call("conversations.replies", {"channel": cid, "ts": m["ts"], "limit": 100})
            if _r.get("has_more"):
                incomplete("スレッドの一部が 100 件を超えています")
            for r in (_r.get("messages") or [])[1:]:
                print_message(prof, r, channel=None, indent="    ")


def parse_url(url):
    m = ARCHIVE_RE.search(url)
    if not m:
        return None
    cid, ts = m.group(1), f"{m.group(2)}.{m.group(3)}"
    qs = urllib.parse.parse_qs(urllib.parse.urlsplit(url).query)
    return cid, ts, (qs.get("thread_ts") or [None])[0]


def cmd_thread(prof, args):
    if not args:
        die("usage: slk thread <permalink> | slk thread <#channel> <ts>")
    parsed = parse_url(args[0])
    if parsed:
        cid, ts, thread_ts = parsed
        ts = thread_ts or ts
    else:
        if len(args) < 2:
            die("usage: slk thread <#channel> <ts>")
        cid, ts = prof.resolve_channel(args[0]), args[1]
    prof.banner()
    res = prof.call("conversations.replies", {"channel": cid, "ts": ts, "limit": 200})
    if res.get("has_more") or (res.get("response_metadata") or {}).get("next_cursor"):
        incomplete("スレッドが 200 件を超えています。表示は先頭 200 件までです")
    if G.get("--raw"):
        out_json(res)
        return
    msgs = res.get("messages") or []
    name = prof.display_channel(cid)
    if G.get("--json"):
        out_json([msg_dict(prof, m, cid, name) for m in msgs])
        return
    note(f"{name}: スレッド {len(msgs)} 件")
    for i, m in enumerate(msgs):
        print_message(prof, m, channel=None, indent="" if i == 0 else "  ",
                      link=prof.permalink(cid, m.get("ts"), ts) if i == 0 else None)


def cmd_read(prof, args):
    opts, rest = take_opts(args, {"--context": True, "--thread": False})
    if not rest:
        die("usage: slk read <slack の URL> [--context N]")
    parsed = parse_url(rest[0])
    if not parsed:
        die("Slack のメッセージ URL ではありません（…/archives/C…/p… の形）")
    cid, ts, thread_ts = parsed
    n = opt_int(opts, "--context", 0, minimum=0)
    prof.banner()
    res = prof.call("conversations.history",
                    {"channel": cid, "latest": ts, "oldest": ts, "inclusive": True, "limit": 1})
    target = (res.get("messages") or [None])[0]
    if target is None:
        die("メッセージが見つかりません（削除済みか、そのチャンネルを読む権限がない）")
    name = prof.display_channel(cid)
    before = prof.messages_before(cid, ts, n) if n else []
    after = prof.messages_after(cid, ts, n) if n else []
    if not human():
        payload = {"channel": name, "message": msg_dict(prof, target, cid, name),
                   "before": [msg_dict(prof, m, cid, name) for m in before],
                   "after": [msg_dict(prof, m, cid, name) for m in after]}
        if G.get("--raw"):
            payload["raw"] = target
        out_json(payload)
        return
    note(f"{name}")
    for m in before:
        print_message(prof, m, indent="  ")
    print_message(prof, target, link=prof.permalink(cid, ts, thread_ts))
    for m in after:
        print_message(prof, m, indent="  ")
    if target.get("reply_count") or thread_ts:
        root = thread_ts or target.get("thread_ts") or ts
        _rep = prof.call("conversations.replies", {"channel": cid, "ts": root, "limit": 200})
        if _rep.get("has_more") or (_rep.get("response_metadata") or {}).get("next_cursor"):
            incomplete("スレッドが 200 件を超えています。表示は先頭 200 件までです")
        replies = _rep.get("messages") or []
        note(f"スレッド {len(replies)} 件")
        for r in replies[1:]:
            print_message(prof, r, indent="    ")


