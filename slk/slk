class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def file_id(target):
    """F… / permalink / url_private のどれからでもファイル ID を取り出す。

    渡された URL をそのまま叩かないのは、認証情報を Slack 以外へ送らないため。
    ID に落として files.info に問い直し、**API が返した URL だけ**を使う。"""
    m = FILE_ID_RE.search(target or "")
    if not m:
        die(f"ファイル ID を取り出せません: {target}（F… か Slack のファイル URL を渡す）")
    return m.group(1)


def safe_name(name, fallback):
    """ファイル名は Slack から来る値なので、そのまま開かない（../ で外に出られる）。"""
    base = os.path.basename((name or "").strip()).lstrip(".")
    base = re.sub(r"[/\\\x00]", "_", base)
    return base or fallback


def fetch_binary(url, token, hops=3):
    """3xx は Authorization を外して追い直す。配信は署名付き URL に転送されることがあり、
    ヘッダを付けたまま追うとトークンが Slack 以外（CDN）へ渡る。"""
    req = urllib.request.Request(url)
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("User-Agent", USER_AGENT)
    opener = urllib.request.build_opener(_NoRedirect)
    for _ in range(hops):
        try:
            return opener.open(req, timeout=120)
        except urllib.error.HTTPError as e:
            # HTTPError は URLError の派生なので、必ずこちらを先に受ける
            if not 300 <= e.code < 400:
                die(f"ダウンロードに失敗しました: HTTP {e.code}")
            loc = e.headers.get("Location")
            if not loc:
                die(f"HTTP {e.code} が返りましたが転送先がありません")
            loc = urllib.parse.urljoin(req.full_url, loc)
            if urllib.parse.urlsplit(loc).scheme not in REDIRECT_SCHEMES:
                die(f"https 以外へは追いません: {loc}")
            req = urllib.request.Request(loc)
            req.add_header("User-Agent", USER_AGENT)
        except urllib.error.URLError as e:
            die(f"ダウンロードに接続できません: {e.reason}")
    die("リダイレクトが多すぎます")


def file_meta(prof, info):
    return {"id": info.get("id"), "name": info.get("name"), "title": info.get("title"),
            "filetype": info.get("filetype"), "mimetype": info.get("mimetype"),
            "size": info.get("size"), "user": prof.user_name(info["user"]) if info.get("user") else None,
            "time": fmt_ts(info.get("created")), "permalink": info.get("permalink"),
            "channels": [prof.display_channel(c) for c in (info.get("channels") or [])]}


def cmd_file(prof, args):
    opts, rest = take_opts(args, {"-o": True, "--output": True, "--force": False, "--info": False})
    if not rest:
        die("usage: slk file <F… | permalink | URL> [-o <保存先>|-] [--force]\n"
            "       slk file <…> --info    メタデータだけ見る（ダウンロードしない）")
    prof.banner()
    info = prof.call("files.info", {"file": file_id(rest[0])})["file"]

    if opts.get("--info"):
        if human():
            for k, v in file_meta(prof, info).items():
                print(f"{k:10} {v}")
        else:
            out_json(info if G.get("--raw") else file_meta(prof, info))
        return

    url = info.get("url_private_download") or info.get("url_private")
    if not url:
        die(f"実体をダウンロードできない項目です（mode={info.get('mode')}）")
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != "https" or not parts.netloc.endswith(FILE_HOST_SUFFIX):
        die(f"Slack 以外のホストには認証情報を送れません: {url}")

    dest = opts.get("-o") or opts.get("--output")
    if dest == "-":
        res = fetch_binary(url, prof.token)
        shutil.copyfileobj(res, sys.stdout.buffer)
        return
    name = safe_name(info.get("name"), f"{info.get('id')}.{info.get('filetype') or 'bin'}")
    if dest is None:
        dest = name
    elif os.path.isdir(dest):
        dest = os.path.join(dest, name)
    out_dir = os.path.dirname(os.path.abspath(dest))
    if not os.path.isdir(out_dir):
        die(f"保存先のディレクトリがありません: {out_dir}")

    if opts.get("--force"):
        # 既存を消すのはダウンロードが終わってから。途中で失敗して元を失わないようにする
        fd, tmp = tempfile.mkstemp(prefix=".slk-", dir=out_dir)
        try:
            with os.fdopen(fd, "wb") as f:
                shutil.copyfileobj(fetch_binary(url, prof.token), f)
            os.replace(tmp, dest)
        except BaseException:
            if os.path.exists(tmp):
                os.unlink(tmp)
            raise
    else:
        # 存在確認と書き込みを分けると、その隙に作られたファイルを潰す。O_EXCL で
        # 名前の確保そのものを不可分にする
        try:
            # 添付は機微なので --force 経路（mkstemp は 0600）と権限を揃える。
            # open("xb") のままだと umask 次第で他人に読める
            fd = os.open(dest, os.O_CREAT | os.O_EXCL | os.O_WRONLY | O_BINARY, 0o600)
        except FileExistsError:
            die(f"既にあります: {dest}（上書きするなら --force）")
        try:
            with os.fdopen(fd, "wb") as f:
                shutil.copyfileobj(fetch_binary(url, prof.token), f)
        except BaseException:
            # ここで消してよいのは、この呼び出しが作ったファイルだと確定しているため
            if os.path.exists(dest):
                os.unlink(dest)
            raise
    size = os.path.getsize(dest)
    note(f"{info.get('name')} / {info.get('mimetype')} / {size} bytes")
    print(dest)


def cmd_search(prof, args):
    opts, rest = take_opts(args, {"--in": True, "--from": True, "--after": True, "--before": True,
                                  "--on": True, "--limit": True, "--all": False, "--sort": True,
                                  "--asc": False, "--files": False})
    if not rest:
        die('usage: slk search "<query>" [--in #ch] [--from @user] [--after YYYY-MM-DD] [--limit N|--all]')
    q = " ".join(rest)
    if opts.get("--in"):
        v = opts["--in"]
        q += " in:" + (f"<#{v}>" if ID_RE.match(v) else v if v.startswith(("#", "@", "<")) else "#" + v)
    if opts.get("--from"):
        v = opts["--from"]
        q += " from:" + (f"<@{v}>" if ID_RE.match(v) else v if v.startswith(("@", "<")) else "@" + v)
    for flag, op in (("--after", "after"), ("--before", "before"), ("--on", "on")):
        if opts.get(flag):
            q += f" {op}:{opts[flag]}"

    method = "search.files" if opts.get("--files") else "search.messages"
    key = "files" if opts.get("--files") else "messages"
    want = None if opts.get("--all") else opt_int(opts, "--limit", 20)
    params = {"query": q, "sort": opts.get("--sort", "score"),
              "sort_dir": "asc" if opts.get("--asc") else "desc", "highlight": False}

    prof.banner()
    matches, page, total, pages = [], 1, None, 1
    while True:
        # count は 100 で固定する。Slack のオフセットは (page-1)*count なので、
        # 最終ページだけ count を縮めるとオフセットが後ろに戻り、既出の行をもう一度返す
        params["count"] = 100
        params["page"] = page
        res = prof.call(method, params)
        block = res.get(key) or {}
        total = block.get("total")
        pages = (block.get("paging") or {}).get("pages") or 1
        matches.extend(block.get("matches") or [])
        if G.get("--raw") and page == 1 and not opts.get("--all"):
            out_json(res)
            return
        if want and len(matches) >= want:
            matches = matches[:want]
            break
        if page >= pages:
            if total is not None and not want and len(matches) < total:
                incomplete(f"検索: {total} 件中 {len(matches)} 件しか取れませんでした")
            break
        page += 1
        note(f"{len(matches)} 件 …")

    if G.get("--raw"):
        out_json({"query": q, "total": total, "matches": matches})
        return
    if opts.get("--files"):
        rows = [{"id": m.get("id"), "name": m.get("name"), "title": m.get("title"),
                 "user": m.get("username") or (prof.user_name(m["user"]) if m.get("user") else "?"),
                 "time": fmt_ts(m.get("timestamp")), "permalink": m.get("permalink")} for m in matches]
        if G.get("--json"):
            out_json(rows)
            return
        note(f"query: {q}  /  {len(rows)} 件 (全 {total} 件)")
        for r in rows:
            print(f"{r['time']}  {r['user']}  {r['name']}\n  {r['permalink']}\n")
        return

    if G.get("--json"):
        out_json([msg_dict(prof, m, (m.get("channel") or {}).get("id"),
                           "#" + ((m.get("channel") or {}).get("name") or "?"), m.get("permalink"))
                  for m in matches])
        return
    note(f"query: {q}  /  {len(matches)} 件 (全 {total} 件)")
    for m in matches:
        ch = "#" + ((m.get("channel") or {}).get("name") or "?")
        print_message(prof, m, channel=ch, link=m.get("permalink"))


def cmd_ask(prof, args):
    opts, rest = take_opts(args, {"--in": True, "--limit": True, "--context": False,
                                  "--types": True, "--channels": True,
                                  "--after": True, "--before": True})
    if not rest:
        die('usage: slk ask "<キーワード>" [--in #ch] [--context] [--types messages,channels,files]\n'
            '    文章を丸ごと渡すと 0 件になる（キーワード一致のため）')
    params = {"query": " ".join(rest),
              "limit": min(20, opt_int(opts, "--limit", 20)),
              "content_types": opts.get("--types", "messages"),
              "include_context_messages": bool(opts.get("--context"))}
    if opts.get("--channels"):
        params["channel_types"] = opts["--channels"]
    if opts.get("--in"):
        params["context_channel_id"] = prof.resolve_channel(opts["--in"])
    for flag, name in (("--after", "after"), ("--before", "before")):
        if opts.get(flag):
            params[name] = int(to_epoch(opts[flag]))

    prof.banner()
    res = prof.call("assistant.search.context", params)
    if G.get("--raw"):
        out_json(res)
        return
    results = res.get("results") or {}
    msgs = results.get("messages") or []
    chans = results.get("channels") or []
    files = results.get("files") or []
    if G.get("--json"):
        out_json(results)
        return
    if not (msgs or chans or files):
        note("0 件（Real-time Search API の応答形が想定と違う場合は --raw で確認）")
        return
    for m in msgs:
        ch = m.get("channel_name")
        head = f"#{ch}" if ch and not str(ch).startswith("#") else (ch or "?")
        print(f"{head}  {fmt_ts(m.get('message_ts'))}  {m.get('author_name') or '?'}")
        for line in prof.expand(m.get("content") or "").splitlines() or [""]:
            print("  " + line)
        ctx = m.get("context_messages") or {}
        for side, label in (("before", "前"), ("after", "後")):
            for c in ctx.get(side) or []:
                who = c.get("author_name") or "?"
                print(f"    [{label}] {who}: {prof.expand(c.get('content') or '')[:200]}")
        if m.get("permalink"):
            print("  " + m["permalink"])
        print()
    for c in chans:
        print(f"#{c.get('name') or c.get('channel_name') or c.get('id')}  "
              f"{(c.get('description') or c.get('purpose') or '')[:100]}")
    for f in files:
        print(f"[ファイル] {f.get('name') or f.get('title')}  {f.get('permalink') or ''}")


def cmd_channels(prof, args):
    opts, rest = take_opts(args, {"--private": False, "--public": False, "--dm": False,
                                  "--archived": False, "--member": False, "--refresh": False,
                                  "--limit": True})
    prof.banner()
    items = prof.channel_index(refresh=opts.get("--refresh", False))
    needle = (rest[0].lstrip("#@").lower() if rest else "")
    kinds = set()
    if opts.get("--public"):
        kinds.add("public")
    if opts.get("--private"):
        kinds.add("private")
    if opts.get("--dm"):
        kinds |= {"im", "mpim"}
    rows = []
    for cid, r in items.items():
        if kinds and r.get("type") not in kinds:
            continue
        if not kinds and r.get("type") in ("im", "mpim"):
            continue
        if r.get("archived") and not opts.get("--archived"):
            continue
        if opts.get("--member") and not r.get("member"):
            continue
        name = prof.display_channel(cid, r)
        if needle and needle not in name.lower() and needle not in (r.get("topic") or "").lower():
            continue
        rows.append({"id": cid, "name": name, "type": r.get("type"),
                     "members": r.get("num"), "joined": bool(r.get("member")),
                     "archived": bool(r.get("archived")), "topic": r.get("topic") or ""})
    rows.sort(key=lambda r: r["name"])
    if opts.get("--limit"):
        rows = rows[:opt_int(opts, "--limit", 0)]
    if not human():
        out_json(rows)
        return
    note(f"{len(rows)} 件")
    width = max([len(r["name"]) for r in rows] + [10])
    for r in rows:
        marks = ("*" if r["joined"] else " ") + ("A" if r["archived"] else " ")
        num = f"{r['members']}名" if r["members"] is not None else ""
        print(f"{marks} {r['name']:<{width}}  {r['id']}  {r['type']:<7} {num:>7}  {r['topic'][:60]}")


