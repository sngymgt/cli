def take_opts(args, spec):
    """spec は {"--flag": False, "--key": True}。オプションと位置引数に割る。"""
    opts, rest, i = {}, [], 0
    while i < len(args):
        a = args[i]
        if a == "--":
            rest.extend(args[i + 1:])
            break
        if a.startswith("-") and a != "-":
            key, inline = (a.split("=", 1) + [None])[:2]
            if key not in spec:
                die(f"不明なオプション: {key}")
            if spec[key]:
                if inline is None:
                    i += 1
                    if i >= len(args):
                        die(f"{key} には値が必要です")
                    inline = args[i]
                opts[key] = inline
            else:
                if inline is not None:
                    die(f"{key} は値を取りません")
                opts[key] = True
        else:
            rest.append(a)
        i += 1
    return opts, rest


def to_epoch(spec):
    """YYYY-MM-DD / YYYY-MM-DD HH:MM / epoch を秒に。"""
    spec = spec.strip()
    if re.fullmatch(r"\d{9,10}(\.\d+)?", spec):
        return float(spec)
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d", "%Y/%m/%d"):
        try:
            return datetime.strptime(spec, fmt).timestamp()
        except ValueError:
            pass
    die(f"日時として読めません: {spec}（YYYY-MM-DD か epoch）")


def fmt_ts(ts):
    try:
        return datetime.fromtimestamp(float(ts)).strftime("%Y-%m-%d %H:%M")
    except (TypeError, ValueError):
        return str(ts)


# --- transport --------------------------------------------------------------

_last_call = 0.0


def _http(method, verb, token, params):
    global _last_call
    flat = {}
    for k, v in (params or {}).items():
        if v is None:
            continue
        flat[k] = "true" if v is True else "false" if v is False else str(v)
    url = f"{API_BASE}/{method}"
    body = None
    if verb == "GET":
        if flat:
            url += "?" + urllib.parse.urlencode(flat)
    else:
        body = urllib.parse.urlencode(flat).encode()
    req = urllib.request.Request(url, data=body, method=verb)
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("User-Agent", USER_AGENT)
    if body is not None:
        req.add_header("Content-Type", "application/x-www-form-urlencoded")
    wait = MIN_INTERVAL - (time.time() - _last_call)
    if wait > 0:
        time.sleep(wait)
    _last_call = time.time()
    # 既定の opener は転送先が別ホストでも Authorization を持ち回るので、追わせない。
    # ここで運ぶのは失効しないユーザートークン
    opener = urllib.request.build_opener(_NoRedirect)
    with opener.open(req, timeout=60) as res:
        return as_json(res.read())


def call(token, method, params=None, _verb=None, _tries=0):
    # allowlist の判定を _verb より先に置く。_verb が真なら素通りする形にすると、
    # 将来 _verb を渡す呼び出しが 1 つ増えただけで read-only の保証が消える
    if method not in READ_METHODS:
        die(f"{method} は read-only の allowlist にありません（slk api help で一覧）")
    verb = _verb or READ_METHODS[method]
    try:
        res = _http(method, verb, token, params)
    except urllib.error.HTTPError as e:
        if e.code == 429 and _tries < MAX_RETRY:
            try:
                delay = int(e.headers.get("Retry-After") or 30)
            except ValueError:
                delay = 30          # HTTP-date 形式（プロキシや CDN が返す）
            delay = max(1, min(delay, 120))
            warn(f"{method}: レート制限。{delay}s 待って再試行します")
            time.sleep(delay + 1)
            return call(token, method, params, _verb, _tries + 1)
        die(f"{method} -> HTTP {e.code} {e.read().decode()[:500]}")
    except urllib.error.URLError as e:
        die(f"{method} -> 接続できません: {e.reason}")
    if res.get("ok"):
        return res
    err = res.get("error", "?")
    if err == "method_not_supported_for_http_method" and _tries == 0:
        return call(token, method, params, "POST" if verb == "GET" else "GET", 1)
    if err == "missing_scope":
        die(f"{method}: scope 不足。必要={res.get('needed')} / 現在={res.get('provided')}\n"
            f"    slk manifest の scope でアプリを更新し、ワークスペースに再インストールしてください")
    hints = {
        "invalid_auth": "トークンが無効です（slk profile add でやり直す）",
        "token_expired": "トークンの期限が切れています（slk profile add でやり直す）",
        "account_inactive": "アカウントが無効化されています",
        "not_allowed_token_type": "user token (xoxp-) が必要です。bot token では検索できません",
        "not_in_channel": "そのチャンネルに参加していないため読めません",
        "channel_not_found": "チャンネルが見つかりません（ID か、参加済みかを確認）",
        "ratelimited": "レート制限に掛かりました。少し待って再実行してください",
    }
    die(f"{method} -> {err}" + (f"（{hints[err]}）" if err in hints else ""))


def write_call(prof, method, params):
    """書き込みの唯一の入口。宛先が writable.json に無ければ API を呼ばない。

    再試行は 429 だけ。429 は Slack が受け付けずに返すので送り直してよいが、それ以外の
    失敗（特に送信後のタイムアウト）は届いたかどうか分からず、送り直すと二重に投稿される。"""
    if method not in WRITE_METHODS:
        die(f"{method} は書き込みの allowlist にありません")
    prof.require_writable(params.get("channel"))
    for tries in range(MAX_RETRY + 1):
        try:
            res = _http(method, WRITE_METHODS[method], prof.token, params)
            break
        except urllib.error.HTTPError as e:
            if e.code == 429 and tries < MAX_RETRY:
                try:
                    delay = int(e.headers.get("Retry-After") or 30)
                except ValueError:
                    delay = 30
                delay = max(1, min(delay, 120))
                warn(f"{method}: レート制限。{delay}s 待って再試行します")
                time.sleep(delay + 1)
                continue
            die(f"{method} -> HTTP {e.code} {e.read().decode()[:500]}")
        except OSError as e:
            die(f"{method} -> 通信に失敗しました: {getattr(e, 'reason', e)}\n"
                "    届いたかどうかは分かりません。slk history で確かめてから送り直してください")
    if res.get("ok"):
        return res
    err = res.get("error", "?")
    if err == "missing_scope":
        die(f"{method}: このトークンには書き込みの権限がありません（必要={res.get('needed')}）\n"
            "    アプリの User Token Scopes に chat:write を足してから slk login --write で取り直してください")
    hints = {
        "not_in_channel": "そのチャンネルに参加していないので書けません",
        "channel_not_found": "チャンネルが見つかりません（参加していない非公開チャンネルもこうなる）",
        "is_archived": "アーカイブ済みのチャンネルです",
        "msg_too_long": "本文が長すぎます",
        "no_text": "本文が空です",
        "restricted_action": "ワークスペースの設定で投稿が制限されています",
        "invalid_auth": "トークンが無効です（slk login でやり直す）",
        "token_expired": "トークンの期限が切れています（slk login でやり直す）",
    }
    die(f"{method} -> {err}" + (f"（{hints[err]}）" if err in hints else ""))


