def keychain_ok():
    return sys.platform == "darwin" and bool(shutil.which("security"))


def keychain_get(name):
    r = subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE,
                        "-a", name, "-w"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def keychain_set(name, token):
    """トークンを argv に置かない（ps から他プロセスに見える）。security は -w に値を
    渡さないと入力と確認の 2 回読むので、同じ値を 2 行流す。

    start_new_session は必須。security は制御端末があると stdin ではなく /dev/tty から
    読むので、これを外すと対話シェルから実行したときだけ
    「password data for new item:」で無言のまま止まる。"""
    r = subprocess.run(["security", "add-generic-password", "-s", KEYCHAIN_SERVICE,
                        "-a", name, "-U", "-w"],
                       input=f"{token}\n{token}\n", capture_output=True, text=True,
                       start_new_session=True)
    return r.returncode == 0, (r.stderr or "").strip()


def keychain_del(name):
    subprocess.run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", name],
                   capture_output=True)


def wincred_ok():
    return os.name == "nt"


def _wincred():
    """Windows の資格情報マネージャー（advapi32）を ctypes で。jamroll-cli の jr と同じ実装。

    ctypes.wintypes は Windows でしか import できないので、ここで遅延して読む。
    モジュールの先頭に上げると macOS で slk 自体が起動しなくなる。"""
    import ctypes
    from ctypes import wintypes

    advapi32 = ctypes.WinDLL("advapi32", use_last_error=True)

    class FILETIME(ctypes.Structure):
        _fields_ = [("dwLowDateTime", wintypes.DWORD),
                    ("dwHighDateTime", wintypes.DWORD)]

    class CREDENTIAL(ctypes.Structure):
        _fields_ = [("Flags", wintypes.DWORD),
                    ("Type", wintypes.DWORD),
                    ("TargetName", wintypes.LPWSTR),
                    ("Comment", wintypes.LPWSTR),
                    ("LastWritten", FILETIME),
                    ("CredentialBlobSize", wintypes.DWORD),
                    ("CredentialBlob", ctypes.POINTER(ctypes.c_char)),
                    ("Persist", wintypes.DWORD),
                    ("AttributeCount", wintypes.DWORD),
                    ("Attributes", ctypes.c_void_p),
                    ("TargetAlias", wintypes.LPWSTR),
                    ("UserName", wintypes.LPWSTR)]

    advapi32.CredReadW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD,
                                   ctypes.POINTER(ctypes.POINTER(CREDENTIAL))]
    advapi32.CredReadW.restype = wintypes.BOOL
    advapi32.CredWriteW.argtypes = [ctypes.POINTER(CREDENTIAL), wintypes.DWORD]
    advapi32.CredWriteW.restype = wintypes.BOOL
    advapi32.CredDeleteW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD]
    advapi32.CredDeleteW.restype = wintypes.BOOL
    advapi32.CredFree.argtypes = [ctypes.c_void_p]
    advapi32.CredFree.restype = None
    return ctypes, advapi32, CREDENTIAL


def _wincred_target(name):
    # Keychain の (service, account) に揃える。SLK_KEYCHAIN_SERVICE を変えれば試験用に分かれる
    return f"{KEYCHAIN_SERVICE}:{name}"


def wincred_get(name):
    try:
        ctypes, advapi32, CREDENTIAL = _wincred()
        ptr = ctypes.POINTER(CREDENTIAL)()
        if not advapi32.CredReadW(_wincred_target(name), 1, 0, ctypes.byref(ptr)):
            return None
        try:
            c = ptr.contents
            raw = ctypes.string_at(c.CredentialBlob, c.CredentialBlobSize)
            return raw.decode("utf-16-le") or None
        finally:
            advapi32.CredFree(ptr)
    except Exception:
        return None


def wincred_set(name, secret):
    try:
        ctypes, advapi32, CREDENTIAL = _wincred()
        blob = secret.encode("utf-16-le")
        c = CREDENTIAL()
        c.Type = 1                      # CRED_TYPE_GENERIC
        c.TargetName = _wincred_target(name)
        c.CredentialBlobSize = len(blob)
        c.CredentialBlob = ctypes.cast(ctypes.create_string_buffer(blob, len(blob)),
                                       ctypes.POINTER(ctypes.c_char))
        c.Persist = 2                   # CRED_PERSIST_LOCAL_MACHINE
        c.UserName = name
        if not advapi32.CredWriteW(ctypes.byref(c), 0):
            return False, f"CredWriteW が失敗しました（{ctypes.get_last_error()}）"
        return True, ""
    except Exception as e:
        return False, str(e)


def wincred_del(name):
    try:
        _, advapi32, _ = _wincred()
        advapi32.CredDeleteW(_wincred_target(name), 1, 0)
    except Exception:
        pass


# 資格情報ストア: macOS は Keychain、Windows は資格情報マネージャー。どちらも無ければ
# store_ok() が偽で、トークンは env ファイルに平文で置かれる

def store_ok():
    return keychain_ok() or wincred_ok()


def store_get(name):
    if keychain_ok():
        return keychain_get(name)
    if wincred_ok():
        return wincred_get(name)
    return None


def store_set(name, secret):
    if keychain_ok():
        return keychain_set(name, secret)
    if wincred_ok():
        return wincred_set(name, secret)
    return False, "この OS では資格情報ストアを使えません"


def store_del(name):
    if keychain_ok():
        keychain_del(name)
    elif wincred_ok():
        wincred_del(name)


def store_where(name):
    """人に見せる置き場所。Keychain は (service, account)、資格情報マネージャーはターゲット名で探す。"""
    if wincred_ok() and not keychain_ok():
        return f"{STORE_LABEL}（{_wincred_target(name)}）"
    return f"{STORE_LABEL}（service={KEYCHAIN_SERVICE} / account={name}）"


def file_token(dir_):
    path = os.path.join(dir_, "env")
    if not os.path.exists(path):
        return None
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line.startswith("SLACK_USER_TOKEN="):
                tok = line.split("=", 1)[1].strip().strip('"').strip("'")
                if tok:
                    return tok
    return None


def token_where(name):
    """そのプロファイルのトークンがどこにあるか。None なら未認証。"""
    if store_ok() and store_get(name):
        return "keychain"
    if file_token(os.path.join(PROFILE_ROOT, name)):
        return "file"
    return None


