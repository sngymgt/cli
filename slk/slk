                                            確認を挟み、端末でないときは --yes が要る。
                                            & < > は既定でエスケープ（<@U…> を効かせるなら
                                            --no-escape）

ワークスペースの選択は --profile > SLK_PROFILE > slk profile use の順（SLK_TOKEN があればそれが最優先）。
--all は最後まで辿れなかったら exit 1 になる（出力は途中まで）。
search は Slack の検索構文をそのまま渡せる（--in / --from / --after は連結するだけの糖衣）。
ask は前後の文脈ごと取れるが、文章ではなく単語で渡すこと（キーワード一致で、文章は 0 件になる）。

AI エージェントとして使う場合:
  - 投稿の前に、宛先と本文を利用者に見せて同意を得る（--yes はその後に付ける）
  - 許可リストに無い宛先へは書けない。自分で slk writable add せず、利用者に
    「<宛先> は投稿を許可したチャンネルにありません。追加しますか？」と聞く。
    同意を得たら slk writable add を実行し、出たダイアログで許可してもらうよう伝える
  - writable.json を直接編集しない"""


def utf8_stdio():
    """Windows ではパイプやファイルにつないだ標準入出力が ANSI コードページ（日本語なら cp932）に
    なり、本文の絵文字で UnicodeEncodeError になる。AI エージェント（Claude Code は Git Bash）
    から使うと常にこの状態なので、端末以外は UTF-8 にする。端末は Python が Unicode のまま
    書くので触らない。PYTHONIOENCODING / PYTHONUTF8 で明示されていればそれに従う。"""
    if os.name != "nt" or os.environ.get("PYTHONIOENCODING") or sys.flags.utf8_mode:
        return
    for stream in (sys.stdin, sys.stdout, sys.stderr):
        try:
            if stream and not stream.isatty():
                stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError, OSError):
            pass


def main():
    utf8_stdio()
    argv = split_global(sys.argv[1:])
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "manifest":
        return cmd_manifest(args)
    if cmd == "login":
        return cmd_login(args)
    if cmd == "profile":
        return cmd_profile(args)
    if cmd == "api" and args and args[0] in ("help", "-h", "--help"):
        return cmd_api(None, args)
    prof = Profile(active_name())
    table = {"search": cmd_search, "ask": cmd_ask, "channels": cmd_channels, "users": cmd_users,
             "members": cmd_members, "history": cmd_history, "thread": cmd_thread,
             "read": cmd_read, "cache": cmd_cache, "whoami": cmd_whoami, "api": cmd_api,
             "file": cmd_file, "writable": cmd_writable, "post": cmd_post}
    if cmd not in table:
        die(f"未知のコマンド: {cmd}\n\n{USAGE}")
    table[cmd](prof, args)
    if _incomplete:
        die(f"取り切れませんでした（{_incomplete}）。出力は途中までです")


def split_global(argv):
    spec = {"--profile": True, "--json": False, "--raw": False, "--quiet": False}
    keep, i = [], 0
    while i < len(argv):
        a = argv[i]
        key, inline = (a.split("=", 1) + [None])[:2]
        if key in spec:
            if spec[key]:
                if inline is None:
                    i += 1
                    if i >= len(argv):
                        die(f"{key} には値が必要です")
                    inline = argv[i]
                G[key] = inline
            else:
                G[key] = True
        else:
            keep.append(a)
        i += 1
    return keep


