def slack_escape(text):
    """& < > だけを実体参照にする。そのまま送ると <!channel> や <@U…> が通知として効く。"""
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def human_consent(message):
    """人にしか答えられない確認。端末ならその場で聞き、端末が無ければ macOS のダイアログを出す。

    AI エージェントは端末を持たずダイアログも押せないので、ここが許可リストを広げる操作の
    実質的な門になる。--yes や環境変数で飛ばせるようにすると、AI の判断だけで宛先が増える。"""
    if sys.stdin.isatty():
        print(message, file=sys.stderr)
        return input("許可しますか? [y/N] ").strip().lower() in ("y", "yes")
    shown = "利用者の画面に確認ダイアログを出しました。利用者が答えるまで戻りません"
    if sys.platform == "win32":
        note(shown)
        import ctypes
        # MB_YESNO | MB_ICONWARNING | MB_DEFBUTTON2（既定は「いいえ」）| MB_SETFOREGROUND | MB_TOPMOST
        flags = 0x4 | 0x30 | 0x100 | 0x10000 | 0x40000
        return ctypes.windll.user32.MessageBoxW(None, message, "slk", flags) == 6   # IDYES
    if shutil.which("osascript"):
        note(shown)
        return _consent_macos(message)
    if shutil.which("zenity") and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        note(shown)
        # --no-markup が無いとチャンネル名の < & が Pango のマークアップとして解釈される
        res = subprocess.run(["zenity", "--question", "--title=slk", "--no-markup", "--timeout=120",
                              "--ok-label=許可する", "--cancel-label=許可しない", "--default-cancel",
                              f"--text={message}"], capture_output=True)
        return res.returncode == 0
    die("端末でもダイアログを出せる環境でもないので、利用者の同意を確かめられません\n"
        "    利用者が自分の端末で slk writable add を実行してください")


def _consent_macos(message):
    # 文言は argv で渡す。スクリプトに埋め込むと、チャンネル名の " で AppleScript が組み変わる
    script = ['on run argv',
              'display dialog (item 1 of argv) with title "slk" buttons {"許可しない", "許可する"} '
              'default button "許可しない" cancel button "許可しない" with icon caution '
              'giving up after 120',
              'end run']
    cmd = ["osascript"]
    for line in script:
        cmd += ["-e", line]
    res = subprocess.run(cmd + [message], capture_output=True, text=True)
    return res.returncode == 0 and "button returned:許可する" in res.stdout \
        and "gave up:true" not in res.stdout


def cmd_writable(prof, args):
    sub = args[0] if args else "list"
    rest = args[1:]
    chans = prof.writable()
    if sub in ("list", "ls"):
        if not human():
            out_json({"profile": prof.name, "channels": chans})
            return
        if not chans:
            note(f"{prof.name}: 書き込める宛先はありません（slk writable add <#channel>）")
            return
        for cid, name in chans.items():
            print(f"{cid}\t{name}")
        return
    if sub == "add":
        if not rest:
            die("usage: slk writable add <#channel|@user|C…> ...")
        new = {}
        for spec in rest:
            if spec.startswith("-"):
                die(f"不明なオプション: {spec}（add は利用者の確認を省略できません）")
            cid = prof.resolve_channel(spec, exact=True)
            if cid not in chans:
                new[cid] = prof.channel_name(cid)
        if not new:
            note("すべて登録済みです")
            return
        team = prof.team().get("team") or prof.name
        lines = "\n".join(f"  {n} ({c})" for c, n in new.items())
        if not human_consent(f"{team} で、次の宛先への投稿を許可しますか？\n\n{lines}"):
            die("追加しませんでした（利用者が許可していません）")
        chans.update(new)
        prof.save_writable(chans)
        for cid, name in new.items():
            print(f"追加: {name} ({cid})")
        return
    if sub in ("rm", "remove"):
        if not rest:
            die("usage: slk writable rm <#channel|@user|C…> ...")
        for spec in rest:
            # 改名・アーカイブ後でも外せるよう、まず登録時の ID と名前で探す
            hit = spec if spec in chans else next(
                (c for c, n in chans.items() if n.lower() == spec.lower()
                 or n.lstrip("#@").lower() == spec.lstrip("#@").lower()), None)
            if hit is None:
                hit = prof.resolve_channel(spec, exact=True)
            if hit not in chans:
                die(f"許可リストにありません: {spec}")
            print(f"削除: {chans.pop(hit)} ({hit})")
        prof.save_writable(chans)
        return
    die("usage: slk writable [list|add|rm] ...")


def cmd_post(prof, args):
    opts, rest = take_opts(args, {"--thread": True, "--yes": False, "-y": False,
                                  "--no-escape": False})
    usage = ("usage: slk post <#channel|@user|C…|permalink> [本文|-] [--thread <ts|permalink>] "
             "[--yes] [--no-escape]")
    if not rest or len(rest) > 2:
        die(usage + ("\n    本文は 1 つの引数にまとめてください（引用符で囲む）" if len(rest) > 2 else ""))
    target, body = rest[0], (rest[1] if len(rest) > 1 else "-")

    parsed = parse_url(target)
    thread = None
    if parsed:
        cid, ts, thread_ts = parsed
        thread = thread_ts or ts
    else:
        cid = prof.resolve_channel(target, exact=True)
    if opts.get("--thread"):
        if thread:
            die("permalink を宛先にしたときは --thread を付けません（そのスレッドに返信します）")
        t = opts["--thread"]
        p = parse_url(t)
        if p:
            if p[0] != cid:
                die("--thread の permalink が宛先と別のチャンネルです")
            thread = p[2] or p[1]
        elif TS_RE.match(t):
            thread = t
        else:
            die(f"--thread には ts（1234567890.123456）か permalink を渡してください: {t}")
    # 本文を組み立てる前に止める。標準入力を読み切ってから断ると、パイプの元が無駄になる
    prof.require_writable(cid)

    if body == "-":
        if sys.stdin.isatty():
            die(usage + "\n    本文を引数か標準入力で渡してください")
        body = sys.stdin.read()
    text = body.rstrip("\n")
    if not text.strip():
        die("本文が空です")
    if not opts.get("--no-escape"):
        text = slack_escape(text)

    name = prof.display_channel(cid)
    if not (opts.get("--yes") or opts.get("-y")):
        if not sys.stdin.isatty():
            die("確認できない環境です（内容を確かめたうえで --yes を付けてください）")
        where = f"{name} ({cid})" + (f" のスレッド {thread}" if thread else "")
        print(f"宛先: {where}  [workspace: {prof.name}]", file=sys.stderr)
        for line in body.rstrip("\n").splitlines():
            print(f"  | {line}", file=sys.stderr)
        if input("投稿しますか? [y/N] ").strip().lower() not in ("y", "yes"):
            die("中止しました")

    params = {"channel": cid, "text": text}
    if thread:
        params["thread_ts"] = thread
    res = write_call(prof, "chat.postMessage", params)
    if G.get("--raw"):
        out_json(res)
        return
    ts = res.get("ts")
    link = prof.permalink(cid, ts, thread)
    if G.get("--json"):
        out_json({"channel": cid, "name": name, "ts": ts, "thread_ts": thread, "permalink": link})
        return
    note(f"投稿しました: {name}")
    print(link)


