def _peek(path):
    try:
        return json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def load_app():
    """OAuth アプリの設定。個人の設定ディレクトリ → スクリプトと同じ場所（＝リポジトリ）の順。

    リポジトリ側は配布される共有の既定値なので、個人の上書きが勝つ向きにする。
    値が空のものは「未記入のひな型」として次の候補へ進む。"""
    here = os.path.dirname(os.path.realpath(__file__))
    blank = []
    for path in (os.path.join(CONFIG_ROOT, "app.json"), os.path.join(here, "app.json")):
        if not os.path.exists(path):
            continue
        try:
            blob = json.load(open(path, encoding="utf-8"))
        except ValueError as e:
            die(f"{path} が JSON として読めません: {e}")
        if blob.get("client_id") and blob.get("redirect_uri"):
            return blob, path
        blank.append(path)
    if blank:
        missing = [k for k in ("client_id", "redirect_uri") if not _peek(blank[0]).get(k)]
        die(f"{blank[0]} の {' と '.join(missing)} が空です。\n"
            "    client_id は Slack アプリの Basic Information、\n"
            "    redirect_uri は OAuth & Permissions に登録した Redirect URL（末尾スラッシュまで一致）")
    die(f"app.json がありません（{os.path.join(CONFIG_ROOT, 'app.json')} を作るか、"
        "リポジトリ同梱のものを記入してください）")


def secret_account(app):
    return f"{APP_SECRET_PREFIX}.{app['client_id']}"


def app_secret(app, reset=False):
    acct = secret_account(app)
    if not reset:
        sec = store_get(acct) if store_ok() else None
        if sec:
            return sec
    if not sys.stdin.isatty():
        die(f"client_secret が {STORE_LABEL}（account={acct}）にありません。"
            "対話環境で slk login を 1 度実行してください")
    note(f"アプリの client_secret を登録します（{STORE_LABEL} に入り、次回から聞きません）")
    note("入れ直したいときは slk login --reset-secret")
    sec = getpass.getpass("client_secret: ").strip()
    if not sec:
        die("client_secret が空です")
    if store_ok():
        ok, err = store_set(acct, sec)
        if not ok:
            warn(f"{STORE_LABEL} に保存できませんでした（今回だけ使います）: {err}")
    return sec


def oauth_exchange(app, secret, code):
    body = urllib.parse.urlencode({
        "client_id": app["client_id"], "client_secret": secret,
        "code": code, "redirect_uri": app["redirect_uri"]}).encode()
    req = urllib.request.Request("https://slack.com/api/oauth.v2.access", data=body, method="POST")
    req.add_header("Content-Type", "application/x-www-form-urlencoded")
    req.add_header("User-Agent", USER_AGENT)
    try:
        with urllib.request.build_opener(_NoRedirect).open(req, timeout=60) as res:
            blob = as_json(res.read())
    except urllib.error.HTTPError as e:
        die(f"oauth.v2.access -> HTTP {e.code} {e.read().decode()[:300]}")
    if not blob.get("ok"):
        return None, blob.get("error", "?")
    authed = blob.get("authed_user") or {}
    if not authed.get("access_token"):
        die("user token が返りませんでした（認可 URL の user_scope を確認してください）")
    return authed, None


class _Catcher(http.server.BaseHTTPRequestHandler):
    """着地ページの JS から投げ返される 1 リクエストだけを拾う。

    **state が一致しないリクエストは捨てる。** 待ち受けはローカルの誰でも叩けるので、
    これが無いと他人の認可コードを流し込んで、client_secret を持つこちら側に交換させ、
    攻撃者のワークスペースのトークンを掴ませられる（`error=` だけ投げれば妨害もできる）。
    貼り付け経路の warn は「人間が code だけを貼った」場合のためのもので、
    そこを緩めたままここに適用してはいけない。
    """
    result = None
    expect_state = None

    def do_GET(self):
        q = {k: v[0] for k, v in
             urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query).items()}
        if "code" not in q and "error" not in q:
            self.send_response(404)
            self.end_headers()
            return
        if not _Catcher.expect_state or q.get("state") != _Catcher.expect_state:
            self.send_response(404)
            self.end_headers()
            return
        _Catcher.result = q
        page = ("<!doctype html><meta charset=utf-8><title>slk</title>"
                "<p style='font:16px system-ui;padding:2rem'>"
                "認証できました。ターミナルに戻ってください。</p>").encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(page)))
        self.end_headers()
        self.wfile.write(page)

    def log_message(self, *a):
        pass


def serve_once(srv, timeout, state):
    _Catcher.result = None
    _Catcher.expect_state = state
    srv.timeout = 1
    deadline = time.time() + timeout
    while time.time() < deadline and _Catcher.result is None:
        srv.handle_request()
    srv.server_close()
    return _Catcher.result


def parse_pasted(raw):
    raw = raw.strip()
    if not raw:
        die("入力が空です")
    if raw.startswith("http") or "?" in raw:
        return {k: v[0] for k, v in
                urllib.parse.parse_qs(urllib.parse.urlsplit(raw).query).items()}
    return {"code": raw}


def install_token(name, token, auth, quiet=False):
    """プロファイルを作ってトークンを保存する。profile add と login の共通処理。"""
    dir_ = profile_dir(name)
    os.makedirs(os.path.join(dir_, "cache"), exist_ok=True)
    os.chmod(PROFILE_ROOT, 0o700)
    os.chmod(dir_, 0o700)
    stored, err = store_set(name, token) if store_ok() else (False, "この OS では資格情報ストアを使えません")
    if stored:
        write_env_stub(dir_)
        if not quiet:
            print(f"トークンは {store_where(name)} に保存しました")
    else:
        env_path = os.path.join(dir_, "env")
        # open してから chmod すると、その間は umask の権限で読める。ここに置くのは
        # 平文のユーザートークンなので、作成時の mode で 0600 を確定させる
        fd = os.open(env_path, os.O_CREAT | os.O_TRUNC | os.O_WRONLY | O_BINARY, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(f"SLACK_USER_TOKEN={token}\n")
        warn(f"{STORE_LABEL} に保存できなかったので {env_path} に平文で置きました: {err}")
    blob = save_team(dir_, auth)
    with open(os.path.join(dir_, ".label"), "w", encoding="utf-8") as f:
        f.write(f"{blob['team']} ({blob['user']})\n")
    if not os.path.exists(ACTIVE_FILE):
        os.makedirs(CONFIG_ROOT, exist_ok=True)
        with open(ACTIVE_FILE, "w", encoding="utf-8") as f:
            f.write(name + "\n")
        print(f"有効なプロファイルにしました（切り替えは slk profile use <name>）")
    return blob


def profile_identity(name):
    """そのプロファイルのトークンが誰のものか。(team_id, user_id) が同じなら同じ人。"""
    blob = _peek(os.path.join(PROFILE_ROOT, name, "team.json"))
    return (blob.get("team_id"), blob.get("user_id"))


def cmd_login(args):
    opts, rest = take_opts(args, {"--manual": False, "--timeout": True, "--reset-secret": False,
                                  "--write": False})
    app, app_path = load_app()
    scopes = list(app.get("user_scopes") or USER_SCOPES)
    if opts.get("--write"):
        scopes += [s for s in WRITE_SCOPES if s not in scopes]
    secret = app_secret(app, reset=bool(opts.get("--reset-secret")))
    nonce = secrets.token_urlsafe(16)

    srv = None
    if not opts.get("--manual"):
        try:
            srv = http.server.HTTPServer(("127.0.0.1", 0), _Catcher)
        except OSError as e:
            warn(f"ローカルの受け口を開けませんでした（貼り付け方式にします）: {e}")
    # 着地ページは state の先頭からポートを読んでここへ投げ返す。0 なら貼り付け方式
    state = f"{srv.server_port if srv else 0}.{nonce}"
    url = AUTHORIZE_URL + "?" + urllib.parse.urlencode({
        "client_id": app["client_id"],
        "user_scope": ",".join(scopes),
        "redirect_uri": app["redirect_uri"],
        "state": state})

    note(f"設定: {app_path}")
    note("ブラウザで承認してください。開かない場合は次の URL を開いてください:")
    print(url, file=sys.stderr)
    try:
        webbrowser.open(url)
    except Exception:
        pass

    got = None
    if srv:
        got = serve_once(srv, opt_int(opts, "--timeout", 300), state)
        if got is None:
            warn("ブラウザから自動で受け取れませんでした。貼り付けに切り替えます")
    if got is None:
        if not sys.stdin.isatty():
            die("対話環境ではないので貼り付けができません")
        got = parse_pasted(input("着地したページの URL（または code）を貼ってください: "))

    if got.get("error"):
        die(f"承認されませんでした: {got['error']}")
    if "state" in got:
        if got["state"] != state:
            die("state が一致しません。別の認証の応答かもしれないので中断しました")
    else:
        warn("state を検証できませんでした（code だけを貼った場合はこの警告が出ます）")
    if not got.get("code"):
        die("code が取れませんでした")

    authed, err = oauth_exchange(app, secret, got["code"])
    if err in BAD_SECRET_ERRORS:
        # 誤入力・ローテーション後の古い値がストアに残っているケース。
        # 入れ直して同じ code でもう 1 度だけ試す（失敗した交換では code は消費されない）
        warn(f"client_secret が受け付けられませんでした（{err}）")
        if not sys.stdin.isatty():
            die("対話環境で slk login --reset-secret を実行して入れ直してください")
        secret = app_secret(app, reset=True)
        authed, err = oauth_exchange(app, secret, got["code"])
    if err:
        hints = {
            "invalid_code": "コードは 1 度きり・数分で失効します。slk login からやり直してください",
            "bad_redirect_uri": "app.json の redirect_uri が Slack 側の登録と完全一致していません",
            "invalid_client_id": "app.json の client_id が違います",
            "bad_client_secret": "slk login --reset-secret で入れ直してください",
        }
        die(f"トークン交換に失敗しました: {err}" + (f"（{hints[err]}）" if err in hints else ""))
    token = authed["access_token"]
    granted = set(filter(None, (authed.get("scope") or "").split(",")))
    if opts.get("--write") and not set(WRITE_SCOPES) <= granted:
        warn("書き込みの権限が付きませんでした。アプリの User Token Scopes に "
             + ", ".join(WRITE_SCOPES) + " があるか確認してください")
    elif not opts.get("--write") and granted & set(WRITE_SCOPES):
        # user token の scope は以前の認可と足し合わされるので、--write を外しても書ける権限が残る
        warn("このトークンには以前の認可で書き込みの権限が残っています"
             "（外すにはアプリの認可を取り消してから slk login し直す）")
    # 上書きしてよいのは「同じワークスペースの同じ人」のプロファイルだけ。team_id だけで
    # 一致を見ると、同じワークスペースの別アカウントで入ったときに他方を潰す
    ident = (auth.get("team_id"), auth.get("user_id"))
    name = rest[0] if rest else None
    if not name and all(ident):
        matches = [p for p in list_profiles() if profile_identity(p) == ident]
        if len(matches) > 1:
            die("同じアカウントのプロファイルが複数あります: " + ", ".join(matches) +
                "\n    どれを更新するか名前で指定してください: slk login <名前>")
        if matches:
            name = matches[0]
    if not name:
        m = re.match(r"https?://([^./]+)\.slack\.com", auth.get("url") or "")
        base = m.group(1) if m else "default"
        name = base
        if os.path.isdir(os.path.join(PROFILE_ROOT, name)) and profile_identity(name) != ident:
            # 同名が別アカウントで使われている。奪わずに別名を作る
            suffix = re.sub(r"[^A-Za-z0-9._-]", "-", auth.get("user") or "alt")
            name = f"{base}-{suffix}"
            if os.path.isdir(os.path.join(PROFILE_ROOT, name)) and profile_identity(name) != ident:
                die(f"'{base}' も '{name}' も別のアカウントで使われています。"
                    "名前を指定してください: slk login <名前>")
    if not NAME_RE.match(name):
        die(f"プロファイル名に使えない文字が含まれています: {name}")
    existing = os.path.isdir(os.path.join(PROFILE_ROOT, name))
    if existing and all(ident) and profile_identity(name) not in (ident, (None, None)):
        warn(f"プロファイル '{name}' は別のアカウントのものです。上書きします")
    blob = install_token(name, token, auth)
    print(f"プロファイル '{name}' を{'更新' if existing else '作成'}しました: "
          f"{blob['team']} / {blob['user']}")


def cmd_manifest(args):
    opts, _ = take_opts(args, {"--name": True, "--search": True, "--write": False})
    scopes = list(USER_SCOPES) + (WRITE_SCOPES if opts.get("--write") else [])
    mode = opts.get("--search", "both")
    if mode == "legacy":
        scopes = [s for s in scopes if not s.startswith("search:read.")]
    elif mode == "rts":
        scopes = [s for s in scopes if s != "search:read"]
    elif mode != "both":
        die("--search は legacy | rts | both")
    out_json({
        "display_information": {"name": opts.get("--name", "slk" if opts.get("--write") else "slk (read-only)"),
                                "description": "個人用の Slack CLI" if opts.get("--write")
                                else "個人用の read-only Slack CLI"},
        "oauth_config": {"scopes": {"user": scopes}},
        "settings": {"org_deploy_enabled": False, "socket_mode_enabled": False,
                     "token_rotation_enabled": False},
    })
    sys.stdout.flush()
    note("手順:")
    note("  1. https://api.slack.com/apps → Create New App → From a manifest")
    note("  2. ワークスペースを選び、上の JSON を貼る")
    note("  3. Install to Workspace → User OAuth Token (xoxp-) をコピー")
    note("  4. slk profile add <name> でトークンを登録")
    note("Distribution は有効にしないこと（履歴 API が 15 件/分に落ちる。戻せない）")
    if mode == "both":
        note("scope の組み合わせが拒否されたら --search legacy か --search rts で作り直す")


def cmd_profile(args):
    sub = (args[0] if args else "list")
    rest = args[1:]

    if sub in ("list", "ls"):
        names = list_profiles()
        if not names:
            print("プロファイルがありません（slk manifest → slk profile add <name>）")
            return
        active = None
        if os.path.exists(ACTIVE_FILE):
            active = open(ACTIVE_FILE, encoding="utf-8").readline().strip()
        elif len(names) == 1:
            active = names[0]
        for n in names:
            label_path = os.path.join(PROFILE_ROOT, n, ".label")
            label = open(label_path, encoding="utf-8").readline().strip() if os.path.exists(label_path) else ""
            where = token_where(n)
            if where is None:
                label = (label + " (未認証)").strip()
            elif where == "file":
                label = (label + " (トークンが平文ファイル: slk profile keychain " + n + ")").strip()
            print(f"{'*' if n == active else ' '} {n:<12} {label}")
        return

    if sub == "current":
        print(active_name())
        return

    if sub == "use":
        if not rest:
            die("usage: slk profile use <name>")
        name = rest[0]
        if not os.path.isdir(profile_dir(name)):
            die(f"プロファイル '{name}' がありません")
        os.makedirs(CONFIG_ROOT, exist_ok=True)
        with open(ACTIVE_FILE, "w", encoding="utf-8") as f:
            f.write(name + "\n")
        print(f"有効なプロファイル: {name}")
        if os.environ.get("SLK_PROFILE"):
            warn(f"環境変数 SLK_PROFILE={os.environ['SLK_PROFILE']} が優先されます")
        return

    if sub == "add":
        if not rest:
            die("usage: slk profile add <name>   (トークンは標準入力から読みます)")
        name = rest[0]
        dir_ = profile_dir(name)
        if os.path.exists(dir_):
            die(f"プロファイル '{name}' は既にあります")
        token = os.environ.get("SLK_TOKEN")
        if not token:
            if sys.stdin.isatty():
                token = getpass.getpass("User OAuth Token (xoxp-…): ").strip()
            else:
                token = sys.stdin.read().strip()
        if not token.startswith("xox"):
            die("Slack のトークンに見えません（xoxp- で始まる User OAuth Token）")
        if token.startswith("xoxb-"):
            die("bot token では検索できません。User OAuth Token (xoxp-) を使ってください")
        auth = call(token, "auth.test")
        blob = install_token(name, token, auth)
        print(f"プロファイル '{name}' を作成しました: {blob['team']} / {blob['user']}")
        return

    if sub == "label":
        if not rest:
            die("usage: slk profile label <name> [表示テキスト]")
        name, text = rest[0], " ".join(rest[1:])
        dir_ = profile_dir(name)
        if not os.path.isdir(dir_):
            die(f"プロファイル '{name}' がありません")
        if not text:
            auth = call(Profile(name).token, "auth.test")
            blob = save_team(dir_, auth)
            text = f"{blob['team']} ({blob['user']})"
        with open(os.path.join(dir_, ".label"), "w", encoding="utf-8") as f:
            f.write(text + "\n")
        print(f"{name}: {text}")
        return

    if sub == "keychain":
        opts, pos = take_opts(rest, {"--force": False})
        name = pos[0] if pos else active_name()
        dir_ = profile_dir(name)
        if not os.path.isdir(dir_):
            die(f"プロファイル '{name}' がありません")
        if not store_ok():
            die("この OS では資格情報ストアを使えません（macOS の Keychain か Windows の資格情報マネージャー）")
        token, existing = file_token(dir_), store_get(name)
        if existing and not token:
            print(f"'{name}': 既に {STORE_LABEL} にあります")
            return
        if existing and token:
            if existing == token:
                write_env_stub(dir_)
                print(f"'{name}': {STORE_LABEL} に同じ値があったので、env ファイルの平文を消しました")
                return
            # ストアの鍵に設定ディレクトリが入らないので、別の設定ディレクトリの同名
            # プロファイルや失効済みの古い値が居座っていることがある。どちらが正しいかは
            # ここでは判定できないので、消さずに止める
            if not opts.get("--force"):
                die(f"'{name}': {STORE_LABEL} の値と env ファイルの値が違います。\n"
                    f"    どちらが有効かはここでは判定できないので、平文は消していません。\n"
                    f"    env の値で {STORE_LABEL} を上書きしてよければ: "
                    f"slk profile keychain {name} --force\n"
                    f"    {STORE_LABEL} 側を残すなら env から SLACK_USER_TOKEN の行を消してください")
            warn(f"'{name}': {STORE_LABEL} の既存の値を env ファイルの値で上書きします")
        if not token:
            die(f"'{name}' に移せるトークンがありません（slk profile add {name} で登録）")
        stored, err = store_set(name, token)
        if not stored:
            die(f"{STORE_LABEL} に保存できませんでした: {err}")
        if store_get(name) != token:
            die(f"{STORE_LABEL} に書いた値を読み戻せませんでした。env ファイルはそのままにしています")
        write_env_stub(dir_)
        print(f"'{name}' のトークンを {store_where(name)} に移しました")
        sys.stdout.flush()
        note("env ファイルは上書きしましたが、ディスク上の旧データが残る可能性はあります。")
        note("気になる場合は Slack 側でトークンを再発行してください。")
        return

    if sub in ("rename", "mv"):
        if len(rest) < 2:
            die("usage: slk profile rename <old> <new>")
        old, new = rest[0], rest[1]
        old_dir, new_dir = profile_dir(old), profile_dir(new)
        if not os.path.isdir(old_dir):
            die(f"プロファイル '{old}' がありません")
        if os.path.exists(new_dir):
            die(f"プロファイル '{new}' は既にあります")
        # ストアの account はプロファイル名そのものなので、先に複製して読み戻せることを
        # 確かめてから元を消す。途中で失敗したら何も壊さずに戻す
        token = store_get(old) if store_ok() else None
        if token:
            ok, err = store_set(new, token)
            if not ok:
                die(f"{STORE_LABEL} に '{new}' を作れませんでした: {err}")
            if store_get(new) != token:
                store_del(new)
                die(f"{STORE_LABEL} に書いた値を読み戻せませんでした。何も変更していません")
        try:
            os.rename(old_dir, new_dir)
        except OSError as e:
            if token:
                store_del(new)
            die(f"ディレクトリを移動できませんでした: {e}")
        if token:
            store_del(old)
            write_env_stub(new_dir)
        if os.path.exists(ACTIVE_FILE) and open(ACTIVE_FILE, encoding="utf-8").readline().strip() == old:
            with open(ACTIVE_FILE, "w", encoding="utf-8") as f:
                f.write(new + "\n")
            print(f"有効なプロファイル名も '{new}' に更新しました")
        print(f"'{old}' を '{new}' に改名しました")
        return

    if sub == "path":
        print(profile_dir(rest[0] if rest else active_name()))
        return

    if sub in ("rm", "remove"):
        opts, pos = take_opts(rest, {"-f": False, "--yes": False})
        if not pos:
            die("usage: slk profile rm <name> [-f]")
        name = pos[0]
        dir_ = profile_dir(name)
        if not os.path.isdir(dir_):
            die(f"プロファイル '{name}' がありません")
        if not (opts.get("-f") or opts.get("--yes")):
            if not sys.stdin.isatty():
                die("対話環境ではないので確認できません（--yes を付けてください）")
            ans = input(f"{dir_} とトークンを削除します。よろしいですか? [y/N] ").strip().lower()
            if ans not in ("y", "yes"):
                die("中止しました")
        for root, dirs, files in os.walk(dir_, topdown=False):
            for f in files:
                os.remove(os.path.join(root, f))
            for d in dirs:
                os.rmdir(os.path.join(root, d))
        os.rmdir(dir_)
        if store_ok():
            store_del(name)
        if os.path.exists(ACTIVE_FILE) and open(ACTIVE_FILE, encoding="utf-8").readline().strip() == name:
            os.remove(ACTIVE_FILE)
        print(f"プロファイル '{name}' を削除しました")
        return

    die(f"不明なサブコマンド: {sub}"
        "（slk profile list|current|use|add|keychain|rename|label|path|rm）")


USAGE = """usage: slk [--profile <name>] [--json|--raw] [--quiet] <command>

